  </svg>`;
}
function svgSuper(color){
  return `<svg viewBox="0 0 300 140" xmlns="http://www.w3.org/2000/svg">
    <rect x="22" y="52" width="6" height="16" fill="#222"/>
    <rect x="50" y="52" width="6" height="16" fill="#222"/>
    <rect x="15" y="48" width="42" height="6" fill="#111"/>
    <path d="M20,112 L20,94 Q20,84 45,80 L100,72 Q120,54 160,52 L195,54 Q215,56 232,70 L262,76 Q283,82 283,96 L283,112 Z" fill="${color}" stroke="#000" stroke-width="2"/>
    <path d="M190,70 L205,54 L222,54 L228,70 Z" fill="#12141a" stroke="#000" stroke-width="1.5"/>
