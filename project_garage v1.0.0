<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PROJECT GARAGE</title>
<style>
  :root{
    --bg: #12130f;
    --panel: #1c1e18;
    --panel-2: #23261e;
    --line: #3a3d33;
    --text: #d9d6c8;
    --dim: #8a8a78;
    --amber: #f2b705;
    --rust: #b5482a;
    --good: #6fae4a;
    --bad: #c0392b;
    --repblue: #4fc3f7;

    --c-basic: #9e9e9e;
    --c-after: #4caf50;
    --c-enhanced: #2196f3;
    --c-advanced: #9c27b0;
    --c-tuned: #ff9800;
    --c-special: #f0d000;
    --c-custom: #e53935;
  }

  *{ box-sizing: border-box; }

  body{
    margin:0;
    background: radial-gradient(ellipse at 30% -10%, #23261a 0%, #0c0d0a 60%);
    color: var(--text);
    font-family: 'Consolas', 'Courier New', monospace;
    min-height: 100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding: 18px;
  }

  #frame{
    width: 1180px;
    max-width: 100%;
    background: var(--panel);
    border: 1px solid var(--line);
    box-shadow: 0 0 0 1px #000, 0 20px 50px rgba(0,0,0,.6);
  }

  #topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    background: linear-gradient(180deg, #24261d, #1a1c16);
    border-bottom: 2px solid var(--amber);
    padding: 12px 20px;
  }

  #topbar .brand{
    font-weight:bold;
    letter-spacing: 2px;
    color: var(--amber);
    font-size: 15px;
  }
  #topbar .brand small{
    display:block;
    color: var(--dim);
    letter-spacing: 3px;
    font-size: 9px;
    margin-top:2px;
  }

  #stats{
    display:flex;
    gap: 26px;
    font-size: 13px;
  }
  #stats .stat{ text-align:right; }
  #stats .stat .label{ color: var(--dim); font-size:10px; letter-spacing:1px; }
  #stats .stat .value{ font-size:16px; font-weight:bold; }
  #cashVal{ color: var(--good); }

  #body{
    display:flex;
    min-height: 560px;
  }

  #nav{
    width: 170px;
    background: #191b14;
    border-right: 1px solid var(--line);
    padding: 14px 0;
  }
  .navbtn{
    display:block;
    width:100%;
    text-align:left;
    background:none;
    border:none;
    color: var(--dim);
    font-family:inherit;
    font-size: 13px;
    padding: 14px 20px;
    cursor:pointer;
    border-left: 3px solid transparent;
    letter-spacing: 1px;
  }
  .navbtn:hover{ color: var(--text); background: #1f2118; }
  .navbtn.active{
    color: var(--amber);
    border-left: 3px solid var(--amber);
    background: #21231a;
  }

  #content{
    flex:1;
    padding: 20px 24px;
    overflow-y: auto;
    max-height: 640px;
  }

  h2.pagetitle{
    margin: 0 0 4px 0;
    font-size: 18px;
    color: var(--text);
    letter-spacing: 1px;
  }
  p.pagesub{
    margin: 0 0 18px 0;
    color: var(--dim);
    font-size: 12px;
  }

  /* --- Websites / cases --- */
  .siteRow{
    background: var(--panel-2);
    border: 1px solid var(--line);
    margin-bottom: 14px;
  }
  .siteHead{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 10px 14px;
    background: #262920;
  }
  .siteHeadLeft{ display:flex; align-items:baseline; gap:10px; }
  .siteHeadRight{ display:flex; align-items:center; gap:10px; }
  .siteHead .name{ font-weight:bold; font-size:13px; letter-spacing:1px; }
  .siteHead .url{ color: var(--dim); font-size: 11px; }
  .repTag{ color: var(--amber); font-size:11px; letter-spacing:1px; white-space:nowrap; }
  .discountTimerTag{ color: var(--good); font-size:11px; letter-spacing:1px; white-space:nowrap; }
  .benefitsBtn{
    background:#242620; border:1px solid var(--line); color:var(--text);
    padding:5px 10px; font-family:inherit; font-size:10px; letter-spacing:1px; cursor:pointer;
  }
  .benefitsBtn:hover{ border-color: var(--amber); color: var(--amber); }

  .caseGrid{
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(150px,1fr));
    gap: 10px;
    padding: 14px;
  }
  .caseCard{
    background:#1a1c15;
    border:1px solid var(--line);
    padding: 10px;
    text-align:center;
    position: relative;
  }
  .caseCard .discBadge{
    position:absolute; top:6px; right:6px; text-align:right; line-height:1.35;
    color: var(--good); font-size:9.5px; font-weight:bold; letter-spacing:0.5px;
  }
  .caseCard .discBadge .leftTag{ display:block; opacity:.85; font-weight:normal; }
  .caseCard .stars{ color: var(--amber); font-size: 13px; letter-spacing:2px; margin-bottom:4px;}
  .caseCard .caseName{ font-size: 12px; margin-bottom: 8px; color:var(--text); }
  .caseCard .price{ font-size: 13px; color: var(--good); margin-bottom: 4px; }
  .caseCard .priceNote{ color: var(--dim); font-size:9px; margin-bottom:8px; }
  .caseCard .strike{ color: var(--dim); text-decoration: line-through; font-size:11px; margin-right:4px; }
  .buyBtn{
    width:100%;
    background: var(--rust);
    border:1px solid #7c2f1a;
    color:#fff;
    padding: 7px 0;
    font-family:inherit;
    font-size:11px;
    letter-spacing:1px;
    cursor:pointer;
  }
  .buyBtn:hover{ background:#cf5530; }
  .buyBtn:disabled{ background:#3a3a34; color:var(--dim); cursor:not-allowed; border-color:var(--line); }

  /* --- Inventory --- */
  .invFilters{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom: 14px;
  }
  .filterBtn{
    background:#1e2019;
    border:1px solid var(--line);
    color:var(--dim);
    padding: 5px 10px;
    font-family:inherit;
    font-size:11px;
    cursor:pointer;
  }
  .filterBtn.active{ color: var(--amber); border-color: var(--amber); }

  .partGrid{
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(180px,1fr));
    gap: 12px;
  }
  .partCard{
    background: #191a15;
    border: 1px solid var(--rarity, var(--line));
    box-shadow: inset 0 0 0 1px #000;
    padding: 10px;
    position:relative;
  }
  .partCard .tag{
    display:inline-block;
    font-size:9px;
    letter-spacing:1px;
    padding:2px 6px;
    margin-bottom:6px;
    color:#0a0a0a;
    background: var(--rarity, #999);
    font-weight:bold;
  }
  .partCard .pname{ font-size:12.5px; margin-bottom:2px; line-height:1.3; min-height: 32px;}
  .partCard .pcat{ color: var(--dim); font-size:10px; margin-bottom:6px; }
  .partCard .pval{ color: var(--good); font-size:12px; margin-bottom:8px; }
  .partCard .pcar{ color: var(--dim); font-size:9.5px; margin:-2px 0 8px 0; padding-top:6px; border-top:1px solid var(--line); letter-spacing:0.5px; }
  .partCard .pcar b{ color: var(--amber); font-weight:normal; }
  .partCard .discBadge{
    position:absolute; top:6px; right:6px; text-align:right; line-height:1.35;
    color: var(--good); font-size:9.5px; font-weight:bold; letter-spacing:0.5px;
  }
  .partCard .strike{ color: var(--dim); text-decoration: line-through; font-size:10px; margin-right:4px; }
  .partCard .demojiBig{ font-size:34px; text-align:center; margin:4px 0; }
  .cardBtns{ display:flex; gap:6px; }
  .smallBtn{
    flex:1;
    background:#242620;
    border:1px solid var(--line);
    color:var(--text);
    padding:6px 4px;
    font-family:inherit;
    font-size:10px;
    cursor:pointer;
  }
  .smallBtn:hover{ border-color: var(--amber); color: var(--amber); }
  .smallBtn.on{ color:var(--amber); border-color:var(--amber); }
  .smallBtn:disabled{ color:var(--dim); cursor:not-allowed; }
  .lockIcon{ position:absolute; top:8px; right:8px; font-size:12px; }

  .emptyMsg{ color: var(--dim); font-size: 12px; padding: 30px 0; text-align:center; }

  /* --- Market --- */
  .marketGrid{
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(220px,1fr));
    gap: 14px;
  }
  .listingCard{
    background:#191a15;
    border: 1px solid var(--rarity, var(--line));
    padding: 12px;
    cursor:pointer;
  }
  .listingCard:hover{ background:#20221a; }
  .listingCard .timer{ float:right; color: var(--amber); font-size:11px; }
  .listingCard .offCount{ color: var(--dim); font-size: 11px; margin-top:6px; }
  .listingCard .lcar{ color: var(--dim); font-size:10px; margin-top:2px; }
  .listingCard .lcar b{ color: var(--amber); font-weight:normal; }

  #marketSlots{ color: var(--dim); font-size: 12px; margin-bottom: 14px; }

  /* --- PARTFINDR (Market's retro search-engine front page) --- */
  .pfBrowserChrome{ background:#15160f; border:1px solid var(--line); margin-bottom:16px; }
  .pfChromeTop{ display:flex; align-items:center; gap:10px; padding:8px 10px; border-bottom:1px solid var(--line); }
  .pfNavArrows{ color:var(--dim); font-size:11px; letter-spacing:3px; user-select:none; }
  .pfUrlBar{ flex:1; background:#0d0e0a; border:1px solid var(--line); color:var(--dim); font-size:11px; padding:6px 10px; letter-spacing:0.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .pfBookmarksBar{ display:flex; gap:16px; padding:6px 12px; background:#191a15; font-size:10px; letter-spacing:1px; flex-wrap:wrap; border-bottom:1px solid var(--line); }
  .pfBookmarksBar span{ color:var(--dim); cursor:default; opacity:.75; }
  .pfPage{ background:#101109; min-height: 420px; padding: 4px 16px 24px; }

  .pfHome{ text-align:center; padding: 54px 16px 30px; }
  .pfLogo{ font-size:32px; letter-spacing:5px; color:var(--amber); font-weight:bold; margin-bottom:6px; display:inline-block; cursor:pointer; }
  .pfTagline{ color:var(--dim); font-size:10.5px; letter-spacing:2px; margin-bottom:26px; }
  .pfSearchWrap{ position:relative; max-width:420px; margin:0 auto 18px auto; text-align:left; }
  .pfSearchInput{ width:100%; background:#1a1c15; border:1px solid var(--line); color:var(--text); padding:12px 14px; font-family:inherit; font-size:13px; letter-spacing:0.5px; }
  .pfSearchInput:focus{ outline:none; border-color:var(--amber); }
  .pfAutofillList{ position:absolute; top:100%; left:0; right:0; background:#1e2019; border:1px solid var(--amber); border-top:none; z-index:10; display:none; max-height:220px; overflow-y:auto; }
  .pfAutofillItem{ padding:9px 14px; font-size:12px; cursor:pointer; border-bottom:1px solid var(--line); text-align:left; }
  .pfAutofillItem:hover{ background:#262920; color:var(--amber); }
  .mktRepTag{ color: var(--repblue); font-size:11px; letter-spacing:1px; margin-bottom:16px; }
  .mktRepTag b{ font-size:13px; }
  .pfBtnRow{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-bottom:6px; }
  .pfActionBtn{ background:#242620; border:1px solid var(--line); color:var(--text); padding:10px 20px; font-family:inherit; font-size:12px; letter-spacing:1px; cursor:pointer; }
  .pfActionBtn:hover{ border-color: var(--amber); color: var(--amber); }
  .pfHint{ color:var(--dim); font-size:10.5px; margin-top:22px; max-width:420px; margin-left:auto; margin-right:auto; }
  .pfRestock{ color:var(--dim); font-size:11px; margin-bottom:14px; }
  .pfNoResults{ text-align:center; padding:70px 16px; }
  .pfNoResults .big{ font-size:19px; color:var(--text); margin-bottom:10px; }
  .pfNoResults p{ color:var(--dim); font-size:12px; max-width:380px; margin:0 auto; }

  /* --- SITEFINDR (WEBSITES tab's own mock search engine) --- */
  .sfResultsHead{ padding: 20px 4px 18px; }
  .sfLogo{ font-size:22px; letter-spacing:4px; color:var(--amber); font-weight:bold; margin-bottom:6px; }
  .sfQuery{ color:var(--dim); font-size:11px; }
  .sfQuery b{ color:var(--text); }
  .sfResultsList{ display:flex; flex-direction:column; }
  .sfResult{ cursor:pointer; padding:16px 4px; border-bottom:1px solid var(--line); }
  .sfResult:last-child{ border-bottom:none; }
  .sfResult:hover{ background:#161710; }
  .sfResultTitle{ color:var(--amber); font-size:15px; font-weight:bold; margin-bottom:2px; }
  .sfResult:hover .sfResultTitle{ text-decoration:underline; }
  .sfResultUrl{ color:var(--good); font-size:11px; margin-bottom:4px; letter-spacing:0.5px; }
  .sfResultStars{ color:var(--amber); font-size:12px; letter-spacing:2px; margin-bottom:4px; }
  .sfResultDesc{ color:var(--dim); font-size:11.5px; line-height:1.4; }

  .backBtn{
    background:#1e2019;
    border:1px solid var(--line);
    color:var(--dim);
    padding: 7px 12px;
    font-family:inherit;
    font-size:11px;
    letter-spacing:1px;
    cursor:pointer;
    margin-bottom: 16px;
  }
  .backBtn:hover{ color: var(--amber); border-color: var(--amber); }

  .detailMeta{ color: var(--dim); font-size: 12px; margin-bottom: 18px; }

  .offerRow{
    display:flex; justify-content:space-between; align-items:center;
    background:#1e2019; border:1px solid var(--line);
    padding: 10px 12px; margin-bottom:8px; font-size:12px;
  }
  .offerRow .amt{ font-size: 13px; }
  .offerRow .aboveTag{ color: var(--good); font-size:9px; letter-spacing:1px; margin-left:8px; }
  .offerBtns{ display:flex; gap:6px; }
  .acceptBtn{
    background: var(--good); border:none; color:#0a0a0a; font-weight:bold;
    padding: 6px 12px; font-family:inherit; font-size:11px; cursor:pointer;
    white-space: nowrap;
  }
  .acceptBtn:hover{ background:#84c765; }
  .declineBtn{
    background:#242620; border:1px solid var(--line); color:var(--dim);
    padding: 6px 12px; font-family:inherit; font-size:11px; cursor:pointer;
  }
  .declineBtn:hover{ border-color: var(--bad); color: var(--bad); }

  /* case opening scroll reveal */
  #scrollBg{
    position:fixed; inset:0; background: rgba(0,0,0,.92);
    display:none; align-items:center; justify-content:center; flex-direction:column; z-index: 65;
  }
  #scrollBg.show{ display:flex; }
  #scrollLabel{ color: var(--dim); font-size:12px; letter-spacing:2px; margin-bottom:16px; }
  #scrollFrame{ position:relative; width: 660px; max-width: 92vw; }
  #scrollViewport{
    width:100%; height:150px; overflow:hidden; position:relative;
    background:#0d0e0a; border:2px solid var(--amber);
    box-shadow: 0 0 30px rgba(0,0,0,.6);
  }
  #scrollTrack{
    position:absolute; top:0; left:0; height:100%;
    display:flex; align-items:center; gap:12px; padding: 0 12px;
  }
  .scrollCard{
    flex: 0 0 auto;
    width:110px; height:118px;
    background:#191a15;
    border: 2px solid var(--rarity, #666);
    display:flex; align-items:center; justify-content:center;
    font-size: 32px; font-weight:bold; color: var(--rarity, #666);
    position: relative;
  }
  .decalBadge{
    position:absolute; bottom:4px; left:6px; font-size:13px; color: var(--amber);
  }
  #scrollMarker{
    position:absolute; top:-12px; bottom:-12px; left:50%;
    width:2px; background: var(--amber); transform: translateX(-50%);
    box-shadow: 0 0 10px var(--amber);
  }
  #scrollMarker::before, #scrollMarker::after{
    content:''; position:absolute; left:50%; transform:translateX(-50%);
    width:0; height:0; border-left:7px solid transparent; border-right:7px solid transparent;
  }
  #scrollMarker::before{ top:-8px; border-top:9px solid var(--amber); }
  #scrollMarker::after{ bottom:-8px; border-bottom:9px solid var(--amber); }

  /* generic modal (Benefits / Install picker) */
  .modalBg{
    position:fixed; inset:0; background: rgba(0,0,0,.75);
    display:none; align-items:center; justify-content:center; z-index: 55;
  }
  .modalBg.show{ display:flex; }
  .modalBox{
    background: var(--panel);
    border: 2px solid var(--amber);
    padding: 24px;
    width: 460px;
    max-width: 92vw;
    max-height: 82vh;
    overflow-y: auto;
  }
  .modalBox h3{ margin:0 0 4px 0; color:var(--amber); font-size:15px; letter-spacing:1px; }
  .modalSub{ color: var(--dim); font-size:11px; margin-bottom:16px; }
  .upgradeRow{ background:#1e2019; border:1px solid var(--line); padding:12px; margin-bottom:10px; }
  .upgradeRow .uHead{ display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; }
  .upgradeRow .uName{ font-size:12.5px; font-weight:bold; }
  .upgradeRow .uLevel{ color: var(--amber); font-size:11px; }
  .upgradeRow .uDesc{ color: var(--dim); font-size:10.5px; margin-bottom:8px; }
  .upgradeRow .uEffect{ color: var(--good); font-size:10.5px; margin-bottom:8px; }
  .upgradeBtn{
    width:100%; background: var(--rust); border:1px solid #7c2f1a; color:#fff;
    padding: 7px 0; font-family:inherit; font-size:11px; letter-spacing:1px; cursor:pointer;
  }
  .upgradeBtn:hover{ background:#cf5530; }
  .upgradeBtn:disabled{ background:#3a3a34; color:var(--dim); cursor:not-allowed; border-color:var(--line); }
  .closeModal{
    margin-top: 6px; width:100%; background:#242620; border:1px solid var(--line);
    color:var(--text); padding:8px; font-family:inherit; cursor:pointer;
  }

  /* case pull reveal */
  #revealBg{
    position:fixed; inset:0; background: rgba(0,0,0,.9);
    display:none; align-items:center; justify-content:center; flex-direction:column; z-index: 60;
  }
  #revealBg.show{ display:flex; }
  #revealCard{
    width: 260px; padding: 26px 18px; text-align:center;
    background:#191a15; border: 3px solid var(--rarity, #999);
    box-shadow: 0 0 40px var(--rarity, #999);
    transform: scale(0.5); opacity:0;
    transition: transform .4s ease, opacity .4s ease;
  }
  #revealCard.pop{ transform: scale(1); opacity:1; }
  #revealCard .rtag{
    display:inline-block; padding:3px 10px; font-size:11px; font-weight:bold;
    letter-spacing:1px; color:#0a0a0a; background: var(--rarity,#999); margin-bottom:12px;
  }
  #revealCard .rname{ font-size:16px; margin-bottom:6px; }
  #revealCard .rcat{ color: var(--dim); font-size:11px; margin-bottom:10px; }
  #revealCard .rval{ color: var(--good); font-size:14px; }
  #revealCard .rcar{ color: var(--dim); font-size:10.5px; margin-top:8px; padding-top:8px; border-top:1px solid var(--line); letter-spacing:0.5px; }
  #revealCard .rcar b{ color: var(--amber); font-weight:normal; }
  #revealExtras{ width:260px; display:flex; flex-direction:column; gap:8px; margin-top:14px; }
  .revealExtraRow{
    display:flex; justify-content:space-between; align-items:center;
    background:#1e2019; border:1px solid var(--line); padding:7px 10px; font-size:11px;
  }
  .decalChip{
    display:flex; align-items:center; gap:10px;
    background:#1e2019; border:2px solid var(--rarity,#999); padding:8px 12px;
  }
  .decalChip .demoji{ font-size:26px; }
  .decalChip .dstars{ color: var(--amber); font-size:10.5px; margin-top:2px; }
  #revealClose{
    margin-top:20px; background: var(--rust); border:1px solid #7c2f1a; color:#fff;
    padding: 9px 22px; font-family:inherit; font-size:12px; letter-spacing:1px; cursor:pointer;
  }

  /* garage */
  .carGrid{
    display:grid;
    grid-template-columns: repeat(auto-fill, minmax(230px,1fr));
    gap: 14px;
  }
  .carCard{
    background:#191a15; border:1px solid var(--line); padding: 14px; cursor:pointer;
  }
  .carCard.currentCar{ border-color: var(--amber); box-shadow: 0 0 0 1px var(--amber) inset; }
  .carCard .cname{ font-weight:bold; font-size:13px; margin-bottom:4px; }
  .carCard .cmeta{ color:var(--dim); font-size:11px; margin-bottom:8px; }
  .potBar{ height:6px; background:#0e0f0b; margin-bottom:10px; border:1px solid var(--line);}
  .potBar div{ height:100%; background: var(--amber); }
  .carCard .cprice{ color: var(--good); font-size:13px; margin-bottom:10px; }
  .ownedTag{ color: var(--amber); font-size:11px; letter-spacing:1px; margin-bottom:8px; display:block; }

  /* workshop stage â€” category tabs arranged around the car with pointer lines */
  .workshopStage{
    position:relative; width:100%; max-width:900px; margin:0 auto 6px auto;
    aspect-ratio: 16 / 8.4; background:#0d0e0a; border:1px solid var(--line); overflow:hidden;
  }
  .stageLines{ position:absolute; inset:0; width:100%; height:100%; }
  .stageCarWrap{
    position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
    width:42%; z-index:1;
  }
  .stageCarWrap svg{ width:100%; height:auto; display:block; }
  .categoryTab{
    position:absolute; transform:translate(-50%,-50%); width:104px;
    background:#191a15; border:1px solid var(--line); padding:8px 6px;
    text-align:center; cursor:pointer; z-index:2; box-shadow:0 0 0 1px #000;
  }
  .categoryTab:hover{ border-color: var(--amber); }
  .categoryTab.active{ border-color: var(--amber); box-shadow:0 0 0 1px var(--amber) inset; }
  .categoryTab .tabName{ font-size:10.5px; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:3px; }
  .categoryTab .tabCount{ font-size:9.5px; color:var(--dim); }
  .categoryTab.active .tabCount{ color: var(--amber); }

  /* workshop slot panel â€” shown above the stage for the selected category only */
  .slotPanel{ margin-bottom: 16px; min-height: 44px; }
  .slotPanelHead{
    font-size:11px; letter-spacing:1px; color: var(--amber); margin-bottom:10px; text-transform:uppercase;
  }
  .slotPanelGrid{ display:flex; flex-wrap:wrap; gap:10px; }
  .slotCardFlat{
    position:relative; width:140px; min-height:92px;
    background:#191a15; border:1px solid var(--rarity, var(--line)); padding:10px;
  }
  .slotCardFlat.empty{
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    text-align:center; color:var(--dim); border-style:dashed;
  }
  .slotCardFlat.empty:hover{ border-color: var(--amber); color: var(--amber); }
  .slotCardFlat.installing{
    display:flex; align-items:center; justify-content:center; text-align:center; color: var(--amber);
  }
  .slotCardFlat .tag{
    display:inline-block; font-size:9px; letter-spacing:1px; padding:2px 6px; margin-bottom:6px;
    color:#0a0a0a; background: var(--rarity, #999); font-weight:bold;
  }
  .slotCardFlat .pname{ font-size:12px; margin-bottom:4px; line-height:1.3; }
  .slotCardFlat .pval{ font-size:11.5px; color: var(--good); }
  .slotCardFlat .scar{ font-size:9.5px; color: var(--dim); margin-top:2px; }
  .slotCardFlat .scar b{ color: var(--amber); font-weight:normal; }
  .slotCardFlat .slotEmptyLabel{ font-size:11px; letter-spacing:0.5px; }
  .slotCardFlat .slotInstalling{ font-size:11px; letter-spacing:0.5px; }
  .slotRemove{
    position:absolute; top:4px; right:4px; background:#242620; border:1px solid var(--line);
    color:var(--bad); width:16px; height:16px; font-size:11px; line-height:1; cursor:pointer; padding:0;
  }
  .slotRemove:hover{ border-color: var(--bad); }

  #toast{
    position: fixed; bottom: 20px; left:50%; transform: translateX(-50%);
    background:#1e2019; border:1px solid var(--amber); color: var(--text);
    padding: 10px 18px; font-size:12px; display:none; z-index:80;
  }
</style>
</head>
<body>

<div id="frame">
  <div id="topbar">
    <div class="brand">PROJECT GARAGE<small>NIGHT-SHIFT BUILD TERMINAL</small></div>
    <div id="stats">
      <div class="stat"><div class="label">GARAGE</div><div class="value" id="carVal">-</div></div>
      <div class="stat"><div class="label">CASH</div><div class="value" id="cashVal">$0</div></div>
    </div>
  </div>

  <div id="body">
    <div id="nav">
      <button class="navbtn active" data-tab="websites">WEBSITES</button>
      <button class="navbtn" data-tab="inventory">PART INVENTORY</button>
      <button class="navbtn" data-tab="market">MARKET</button>
      <button class="navbtn" data-tab="garage">GARAGE</button>
    </div>

    <div id="content"></div>
  </div>
</div>

<div id="scrollBg">
  <div id="scrollLabel">OPENING CASE...</div>
  <div id="scrollFrame">
    <div id="scrollViewport"><div id="scrollTrack"></div></div>
    <div id="scrollMarker"></div>
  </div>
</div>

<div class="modalBg" id="benefitsModalBg">
  <div class="modalBox">
    <h3 id="benefitsTitle">BENEFITS</h3>
    <div class="modalSub" id="benefitsSub"></div>
    <div id="benefitsBody"></div>
    <button class="closeModal" onclick="closeBenefits()">CLOSE</button>
  </div>
</div>

<div class="modalBg" id="marketRepModalBg">
  <div class="modalBox">
    <h3 id="marketRepTitle" style="color:var(--repblue);">MARKET REPUTATION</h3>
    <div class="modalSub" id="marketRepSub"></div>
    <div id="marketRepBody"></div>
    <button class="closeModal" onclick="closeMarketRepModal()">CLOSE</button>
  </div>
</div>

<div class="modalBg" id="installModalBg">
  <div class="modalBox">
    <h3 id="installModalTitle">CHOOSE PART</h3>
    <div class="modalSub" id="installModalSub"></div>
    <div id="installModalBody"></div>
    <button class="closeModal" onclick="closeInstallPicker()">CLOSE</button>
  </div>
</div>

<div id="revealBg">
  <div id="revealCard">
    <div class="rtag" id="revTag">RARITY</div>
    <div class="rname" id="revName">Part Name</div>
    <div class="rcat" id="revCat">Category</div>
    <div class="rval" id="revVal">$0</div>
    <div class="rcar" id="revCar">Fits: â€”</div>
  </div>
  <div id="revealExtras"></div>
  <button id="revealClose" onclick="closeReveal()">CLOSE</button>
</div>

<div id="toast"></div>

<script>
/* ---------------------------------------------------------
   DATA
--------------------------------------------------------- */
const RARITIES = [
  { key:'basic',    name:'Basic',       color:'#9e9e9e', min:50,   max:150 },
  { key:'after',    name:'Aftermarket', color:'#4caf50', min:150,  max:400 },
  { key:'enhanced', name:'Enhanced',    color:'#2196f3', min:400,  max:900 },
  { key:'advanced', name:'Advanced',    color:'#9c27b0', min:900,  max:1800 },
  { key:'tuned',    name:'Tuned',       color:'#ff9800', min:1800, max:3500 },
  { key:'special',  name:'Specialized', color:'#f0d000', min:3500, max:7000 },
  { key:'custom',   name:'Custom',      color:'#e53935', min:7000, max:15000 },
];

// weight table per star level (index 0 = 1-star ... 4 = 5-star), aligned to RARITIES order
const WEIGHTS = [
  [60,25,10,4,1,0,0],
  [40,30,18,8,3,1,0],
  [25,25,22,15,8,4,1],
  [12,18,22,20,15,9,4],
  [5,10,15,20,22,18,10],
];

const CASE_COST = [150, 400, 900, 1800, 3500];

// Weight table for parts a PURCHASED CAR actually comes with, indexed by potential-1
// (aligned to RARITIES order, same shape as WEIGHTS). Deliberately much more basic-heavy
// than WEIGHTS: a car's sticker price reflects its build potential (see
// expectedPartsValueForPotential, which still prices off the ORIGINAL WEIGHTS table), but
// what's actually bolted in when you buy it skews low â€” so immediately reselling a car is a
// loss, not a flip. High-potential cars still have a decent shot at a couple of solid parts,
// just not several purple/yellow-or-better parts in every category like before.
const CAR_PART_WEIGHTS = [
  [75, 22, 3,  0,   0,   0,   0],
  [65, 27, 7,  1,   0,   0,   0],
  [60, 27, 10, 2,   1,   0,   0],
  [55, 28, 13, 3,   1,   0,   0],
  [50, 30, 14, 4,   1.5, 0.5, 0],
];

const CATEGORIES = ['Engine','Suspension','Body','Exhaust','Wheels','Steering','Brakes','Electrical'];
const INVENTORY_FILTERS = ['All', ...CATEGORIES, 'Decals'];
const PARTFINDR_FILTERS = ['All', ...CATEGORIES];
const PARTFINDR_REFRESH = 300; // seconds between restocks, per searched car
const PARTFINDR_EMPTY_CHANCE = 0.12; // chance an entire refresh yields nothing for a given car
// Rarer parts show up less often per PARTFINDR refresh than common ones (aligned to RARITIES order).
const PARTFINDR_RARITY_WEIGHTS = [39, 27, 16, 9, 5, 3, 1];

const PART_NOUNS = {
  Engine:      ['Block','Piston Set','Camshaft','Turbocharger','Intake Manifold','Fuel Injector','ECU'],
  Suspension:  ['Coilover Kit','Sway Bar','Control Arm','Strut Mount','Bushing Kit','Shock Absorber'],
  Body:        ['Front Bumper','Hood','Fender Flare','Spoiler','Side Skirt','Roof Panel'],
  Exhaust:     ['Muffler','Header Set','Downpipe','Cat-Back System','Resonator'],
  Wheels:      ['Wheel Set','Tire Set','Hub Assembly','Lug Kit','Wheel Spacer'],
  Steering:    ['Steering Rack','Tie Rod','Steering Wheel','Power Steering Pump'],
  Brakes:      ['Brake Caliper','Rotor Set','Brake Pad Set','Brake Line Kit','Master Cylinder'],
  Electrical:  ['Wiring Harness','Battery','Alternator','Ignition Coil','Gauge Cluster'],
};

const RARITY_ADJ = {
  basic:   ['Worn','Stock','Used','Standard'],
  after:   ['Aftermarket','Budget','Street'],
  enhanced:['Enhanced','Sport','Performance'],
  advanced:['Advanced','Race-Spec','Forged'],
  tuned:   ['Tuned','Stage 2','Track-Tuned'],
  special: ['Specialized','Limited','Works-Team'],
  custom:  ['Custom','One-Off','Prototype'],
};

// How long a part takes to install, in seconds, by rarity. Capped at 10 minutes.
const INSTALL_TIME_BY_RARITY = {
  basic:30, after:60, enhanced:120, advanced:240, tuned:360, special:480, custom:600,
};

// Radial layout for the Workshop stage: each category tab sits in a fixed spot
// around the car (percentages of the stage box) with a thin line pointing toward it.
const WORKSHOP_LAYOUT = [
  { cat:'Engine',     x:10, y:15, tx:36, ty:42 },
  { cat:'Suspension', x:10, y:38, tx:30, ty:60 },
  { cat:'Brakes',     x:10, y:61, tx:64, ty:63 },
  { cat:'Steering',   x:10, y:84, tx:50, ty:52 },
  { cat:'Body',       x:90, y:15, tx:50, ty:35 },
  { cat:'Exhaust',    x:90, y:38, tx:23, ty:60 },
  { cat:'Wheels',     x:90, y:61, tx:66, ty:64 },
  { cat:'Electrical', x:90, y:84, tx:53, ty:46 },
];

// Decals: rarity uses a plain 1-5 star scale instead of the part rarity words.
const DECAL_STAR_COLORS = ['#9e9e9e', '#4caf50', '#2196f3', '#ff9800', '#e53935'];
const DECAL_STAR_WEIGHTS = [50, 25, 14, 8, 3]; // 1-star .. 5-star
const DECAL_EMOJIS = ['ðŸ','ðŸ”¥','ðŸ’€','ðŸ‘‘','ðŸŽ¯','ðŸŒŸ','ðŸ¦…','ðŸ‰','âš¡','ðŸ‘»','ðŸ€','ðŸ’Ž','ðŸš€','ðŸŽƒ','ðŸ¦‚','ðŸŒªï¸','ðŸŽ²','ðŸ¥‡'];
const DECAL_NAMES = ['Flame Runner','Skull Rider','Crowned Circuit','Bullseye Drift','Starlight Racer','Iron Eagle','Dragon Tail','Volt Strike','Night Howl','Lucky Clover','Diamond Lap','Rocket Fin','Pumpkin Burnout','Scorpion Sting','Twister Tag','Dice Roll','Gold Medal'];
const BASE_DECAL_CHANCE = 0.04;

// Website Benefits upgrade categories
const UPGRADE_DEFS = [
  { key:'luck',      label:'Case Luck', desc:'Chance to reroll a pull and keep the better rarity.' },
  { key:'discount',  label:'Discount',  desc:'Unlocks a batch of discounted cases that rotates every 5 minutes.' },
  { key:'bogof',     label:'BOGOF',     desc:'Chance to pull extra items from a single case (up to 3 total).' },
  { key:'collector', label:'Collector', desc:'Boosts your odds of a bonus Decal drop.' },
];
const UPGRADE_BASE_COSTS = [100, 220, 400, 700, 1100]; // cost to go from level i to i+1, scaled by site stars

function freshUpgrades(){ return { luck:0, discount:0, bogof:0, collector:0 }; }

const WEBSITES = [
  { name:'JUNKBOX CASES',    url:'junkbox.case',    stars:1, reputation:0, upgrades:freshUpgrades(), discounts:[], discountTimeLeft:0 },
  { name:'STREETLOT.NET',    url:'streetlot.net',   stars:2, reputation:0, upgrades:freshUpgrades(), discounts:[], discountTimeLeft:0 },
  { name:'GRIP&GO SUPPLY',   url:'gripgo.supply',   stars:3, reputation:0, upgrades:freshUpgrades(), discounts:[], discountTimeLeft:0 },
  { name:'REDLINE VAULT',    url:'redlinevault.io', stars:4, reputation:0, upgrades:freshUpgrades(), discounts:[], discountTimeLeft:0 },
  { name:'APEX BLACK MARKET',url:'apexblack.mkt',   stars:5, reputation:0, upgrades:freshUpgrades(), discounts:[], discountTimeLeft:0 },
  { name:'AUTO EXCHANGE',    url:'autoexchange.lot', isCarDealer:true, refreshTime:600, listings:[] },
];

/* ---------------------------------------------------------
   MARKET REPUTATION â€” a separate, blue-branded upgrade track
   earned by buying and selling on the Market/PARTFINDR, rather
   than by the amber Reputation the case WEBSITES use.
--------------------------------------------------------- */
const MARKET_UPGRADE_DEFS = [
  { key:'hotProduct', label:'Hot Product', desc:'Buyers offer slightly more for your listings (capped at 20% more than base rates). LowballChud is immune.' },
  { key:'discount',   label:'Discount',    desc:'Unlocks a batch of discounted PARTFINDR parts that refreshes alongside part stock.' },
  { key:'surplus',    label:'Surplus',     desc:'Increases the odds of more parts being available per PARTFINDR refresh.' },
  { key:'qualityPickings', label:'Quality Pickings', desc:'Purchased cars become more likely to come with better parts inside. Purchase price is unaffected.' },
];
const MARKET_UPGRADE_BASE_COSTS = [150, 320, 550, 900, 1400]; // cost to go from level i to i+1

// Reputation payout by rarity/tier for buying or selling on the Market â€” rarer items pay more.
const MARKET_REP_BY_RARITY = { basic:5, after:12, enhanced:25, advanced:45, tuned:75, special:120, custom:200 };
const MARKET_REP_BY_DECAL_STAR = [8, 20, 40, 70, 110];      // 1-star .. 5-star
const MARKET_REP_BY_CAR_POTENTIAL = [30, 70, 130, 220, 350]; // Build Potential 1-5

// Pool of car platforms the dealer rotates through, grouped by build potential + body silhouette.
const CAR_POOL = [
  { name:"'96 Corolla Wagon",   potential:1, bodyStyle:'hatch' },
  { name:"'94 Civic Hatch",     potential:1, bodyStyle:'hatch' },
  { name:"'90 Sentra",          potential:1, bodyStyle:'hatch' },
  { name:"'88 Tercel",          potential:1, bodyStyle:'hatch' },
  { name:"'02 240SX",           potential:2, bodyStyle:'coupe' },
  { name:"'98 Eclipse GSX",     potential:2, bodyStyle:'coupe' },
  { name:"'01 Prelude",         potential:2, bodyStyle:'coupe' },
  { name:"'99 Civic Si",        potential:2, bodyStyle:'hatch' },
  { name:"'89 Mustang GT",      potential:3, bodyStyle:'muscle' },
  { name:"'95 Miata",           potential:3, bodyStyle:'roadster' },
  { name:"'97 240SX S14",       potential:3, bodyStyle:'coupe' },
  { name:"'00 S2000",           potential:3, bodyStyle:'roadster' },
  { name:"'99 Supra",           potential:4, bodyStyle:'super' },
  { name:"'02 EVO VII",         potential:4, bodyStyle:'coupe' },
  { name:"'04 STI",             potential:4, bodyStyle:'coupe' },
  { name:"'91 180SX",           potential:4, bodyStyle:'coupe' },
  { name:"'93 Skyline GT-R",    potential:5, bodyStyle:'super' },
  { name:"'92 NSX",             potential:5, bodyStyle:'super' },
  { name:"'99 RX-7 Spirit R",   potential:5, bodyStyle:'super' },
  { name:"'02 Viper GTS",       potential:5, bodyStyle:'muscle' },
];

// Every car model that can exist in the game (the dealer rotation pool plus the fixed
// starting car). The full part pool is every category Ã— rarity Ã— adjective Ã— noun combo,
// duplicated once per entry here â€” each generated part gets stamped with one of these as
// the model it fits, so the same "Tuned Turbocharger" that drops for a Supra is a distinct
// item from the one that drops for a Skyline GT-R.
const CAR_MODELS = [...CAR_POOL.map(c => c.name), "'91 Civic Hatch"];

const CAR_COLORS = ['#b5482a','#2196f3','#e53935','#4caf50','#f2b705','#9c27b0','#607d8b','#e8e6de','#1a1a1a','#ff9800'];

// Market buyers â€” wide pool of car-culture usernames, plus two rare easter-egg buyers.
const BUYER_NAMES = [
  'RustyRacerX','GearheadGwen','TrackDayTom','MidnightMod','ShopRatSam','TurboTanya','DriftDave',
  'PitLanePaul','CamshaftCarl','BoostBrenda','NitroNancy','ClutchKicker99','RedlineRita','SlickShiftSteve',
  'GarageQueenGia','BurnoutBrian','ApexApril','LugNutLarry','SpoilerSophie','ChromeChasey','DynoDan',
  'WheelieWendy','GripTapeGreg','ExhaustEddie','TorqueTina','PaddockPatty','JackStandJake','ManifoldMya',
  'RimRunnerRay','OctaneOllie','FenderFinnegan',
];

/* ---------------------------------------------------------
   STATE
--------------------------------------------------------- */
let state = {
  cash: 2000,
  activeTab: 'websites',
  cars: [],        // {id, name, potential, bodyStyle, color, currentProject, listed, shellValue,
                    //  slots:{cat: [{part, installing}, ...]}}  â€” one slot array per category,
                    //  length equal to the car's build potential
  inventory: [],   // parts: {id, category, rarityKey, name, value, locked, listed}
                    // decals: {id, kind:'decal', category:'Decals', name, emoji, starLevel, value, locked, listed}
  listings: [],    // {id, type:'part'|'car', refId, timeLeft, offers:[{id, buyer, amount}]}
  invFilter: 'All',
  invCarFilter: 'All',
  marketDetailId: null,
  market: {
    view: 'home',        // 'home' | 'results' | 'noresults' | 'listings'
    searchText: '',
    lastQuery: '',
    resultsCar: null,
    resultsFilter: 'All',
    reputation: 0,
    upgrades: { hotProduct:0, discount:0, surplus:0, qualityPickings:0 },
  },
  partSearchStock: {},   // carName -> { items:[{...part, price}], timeLeft } â€” PARTFINDR's per-car inventory
  websites: {
    view: 'home',   // 'home' | 'site' | 'dealer'
    siteIdx: null,  // index into WEBSITES when view==='site'
  },
  workshopCarId: null,
  nextId: 1,
};

let installPicker = null;         // {carId, category, slotIndex}
let benefitsSiteIdx = null;
let workshopActiveCategory = null; // which category's slots are currently shown in the Workshop

function rarityByKey(k){ return RARITIES.find(r=>r.key===k); }

// Safely embed a string (car names contain apostrophes, e.g. "'99 Supra") inside a
// single-quoted JS string literal that itself sits inside a double-quoted HTML attribute.
function jsAttrEscape(s){
  return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'");
}
// Escape for raw text/attribute display (user-typed PARTFINDR search queries).
function escapeHtml(s){
  return String(s).replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
}

/* ---------------------------------------------------------
   RNG HELPERS
--------------------------------------------------------- */
function weightedIndex(weights){
  const total = weights.reduce((a,b)=>a+b,0);
  let roll = Math.random()*total;
  for(let i=0;i<weights.length;i++){
    if(roll < weights[i]) return i;
    roll -= weights[i];
  }
  return weights.length-1;
}

function weightedRarity(starIndex){
  return RARITIES[weightedIndex(WEIGHTS[starIndex])];
}

// Rolls what a purchased car actually comes with. Uses the low-biased CAR_PART_WEIGHTS
// table (not WEIGHTS), then â€” same "reroll and keep the better one" pattern as Case Luck â€”
// gives the Quality Pickings market upgrade a chance to bump each slot up to a second roll.
function weightedCarRarity(potential){
  let rarity = RARITIES[weightedIndex(CAR_PART_WEIGHTS[potential-1])];
  if(Math.random() < getQualityPickingsChance()){
    const rarity2 = RARITIES[weightedIndex(CAR_PART_WEIGHTS[potential-1])];
    if(RARITIES.indexOf(rarity2) > RARITIES.indexOf(rarity)) rarity = rarity2;
  }
  return rarity;
}

function makePart(category, rarity, carName){
  const nouns = PART_NOUNS[category];
  const noun = nouns[Math.floor(Math.random()*nouns.length)];
  const adjList = RARITY_ADJ[rarity.key];
  const adj = adjList[Math.floor(Math.random()*adjList.length)];
  const value = Math.floor(rarity.min + Math.random()*(rarity.max-rarity.min));
  // If no specific car was passed in (e.g. a case pull), the part is stamped with a
  // random model from the full CAR_MODELS pool â€” that's its car-specific designation.
  const car = carName || CAR_MODELS[Math.floor(Math.random()*CAR_MODELS.length)];
  return {
    id: state.nextId++,
    category,
    rarityKey: rarity.key,
    name: `${adj} ${noun}`,
    car,
    value,
    locked: false,
    listed: false,
  };
}

function makeDecal(){
  const starIdx = weightedIndex(DECAL_STAR_WEIGHTS);
  const starLevel = starIdx+1;
  const emoji = DECAL_EMOJIS[Math.floor(Math.random()*DECAL_EMOJIS.length)];
  const name = DECAL_NAMES[Math.floor(Math.random()*DECAL_NAMES.length)];
  const value = Math.floor(200*starLevel + Math.random()*300*starLevel);
  return {
    id: state.nextId++,
    kind: 'decal',
    category: 'Decals',
    name,
    emoji,
    starLevel,
    value,
    locked: false,
    listed: false,
  };
}

// Offers skew below market value more often, with an occasional above-value profit offer.
function rollOfferMultiplier(){
  if(Math.random() < 0.72){
    return 0.5 + Math.random()*0.45;   // 0.50x - 0.95x  (below value â€” most common)
  } else {
    return 1.05 + Math.random()*0.5;   // 1.05x - 1.55x  (above value â€” the rare profit offer)
  }
}

/* ---------------------------------------------------------
   WEBSITE BENEFITS â€” scaling math
   Every category's max effect scales with the site's star tier
   (starScale), so maxing a 1-star site's upgrade never matches
   what the same level gets you on a 5-star site.
--------------------------------------------------------- */
function starScale(stars){ return stars/5; }

function getUpgradeCost(stars, level){
  return Math.round(UPGRADE_BASE_COSTS[level] * stars);
}

function getLuckChance(site){
  return 0.30 * starScale(site.stars) * (site.upgrades.luck/5);
}
function getDiscountCount(site){
  return site.upgrades.discount;
}
// Blended scale (floor of 0.4 + up to 0.6 more from star tier) so even a 1-star site's
// level-1 Discount upgrade produces a real, visible discount instead of rounding to nothing â€”
// while a maxed 5-star site still caps out meaningfully higher than a maxed 1-star site.
function getDiscountMaxPct(site){
  if(site.upgrades.discount===0) return 0;
  const effScale = 0.4 + 0.6*starScale(site.stars);
  return Math.min(50, Math.round(10 * site.upgrades.discount * effScale));
}
function getBogofChance(site){
  return 0.25 * starScale(site.stars) * (site.upgrades.bogof/5);
}
function getCollectorBoost(site){
  return 0.20 * starScale(site.stars) * (site.upgrades.collector/5);
}
function getCasePrice(site, category){
  const base = CASE_COST[site.stars-1];
  const d = site.discounts.find(d=>d.category===category);
  if(d) return Math.max(10, Math.round(base * (1 - d.pct/100)));
  return base;
}

// Builds a brand-new batch of discounts for a site: one shared 5-minute cycle, each discount
// getting its own category, percentage, and a random 1-5 use limit. Called when a site first
// unlocks/upgrades the Discount benefit, and again whenever the shared cycle timer expires.
function generateDiscountBatch(site){
  const desired = getDiscountCount(site);
  const maxPct = getDiscountMaxPct(site);
  const discounts = [];
  if(desired <= 0 || maxPct < 5) return discounts;

  const catsShuffled = [...CATEGORIES].sort(()=>Math.random()-0.5);
  const usedPcts = [];
  for(let i=0; i<desired && i<catsShuffled.length; i++){
    let pct, tries=0;
    do{
      pct = 5 + Math.floor(Math.random()*(maxPct-5+1));
      tries++;
    } while(usedPcts.includes(pct) && tries<10);
    usedPcts.push(pct);
    discounts.push({
      category: catsShuffled[i],
      pct,
      usesLeft: 1 + Math.floor(Math.random()*5), // random 1-5 uses
    });
  }
  return discounts;
}

/* ---------------------------------------------------------
   CASE PULL LOGIC
--------------------------------------------------------- */
function rollLuckyRarity(site, starIdx){
  let rarity = weightedRarity(starIdx);
  if(Math.random() < getLuckChance(site)){
    const rarity2 = weightedRarity(starIdx);
    if(RARITIES.indexOf(rarity2) > RARITIES.indexOf(rarity)) rarity = rarity2;
  }
  return rarity;
}

function rollCasePull(site, category){
  const starIdx = site.stars-1;
  const mainPart = makePart(category, rollLuckyRarity(site, starIdx));

  const extraParts = [];
  if(site.upgrades.bogof > 0 && Math.random() < getBogofChance(site)){
    let itemCount = 2;
    if(site.upgrades.bogof >= 4 && Math.random() < 0.4*starScale(site.stars)) itemCount = 3;
    for(let i=1;i<itemCount;i++){
      extraParts.push(makePart(category, rollLuckyRarity(site, starIdx)));
    }
  }

  let decal = null;
  const decalChance = BASE_DECAL_CHANCE + getCollectorBoost(site);
  if(Math.random() < decalChance){
    decal = makeDecal();
  }

  return { mainPart, extraParts, decal };
}

/* ---------------------------------------------------------
   PARTFINDR â€” direct part search/purchase
   Every searched car keeps its own small rotating stock: 3-12 parts, random
   categories (some may repeat, some may be missing entirely), rarity rolled
   off a common-biased weight table, and a chance the whole refresh is empty.
--------------------------------------------------------- */
/* ---------------------------------------------------------
   MARKET REPUTATION â€” upgrade effect math
--------------------------------------------------------- */
function getHotProductBoost(){
  return 0.04 * state.market.upgrades.hotProduct; // 0%, 4%, 8%, 12%, 16%, 20% â€” capped at +20%
}
function getMarketDiscountCount(){
  return state.market.upgrades.discount; // level 1 = 1 discounted item, up to 5 at max
}
function getMarketDiscountMaxPct(){
  const lvl = state.market.upgrades.discount;
  if(lvl<=0) return 0;
  return Math.min(50, lvl*10); // 10%, 20%, 30%, 40%, 50% â€” capped at 50% off
}
function getPartfindrEmptyChance(){
  const surplus = state.market.upgrades.surplus;
  return Math.max(0.03, PARTFINDR_EMPTY_CHANCE - surplus*0.018);
}
function getPartfindrCountRange(){
  const surplus = state.market.upgrades.surplus;
  return 10 + surplus; // random range width added to the base 3 minimum
}
function getQualityPickingsChance(){
  return 0.10 * state.market.upgrades.qualityPickings; // 0%, 10%, 20%, 30%, 40%, 50% â€” capped at level 5
}
function getMarketRepForItem(rarityKeyOrKind, extra){
  if(rarityKeyOrKind==='decal') return MARKET_REP_BY_DECAL_STAR[extra-1] || 0;
  if(rarityKeyOrKind==='car') return MARKET_REP_BY_CAR_POTENTIAL[extra-1] || 0;
  return MARKET_REP_BY_RARITY[rarityKeyOrKind] || 0;
}

// Applies the Discount upgrade to a freshly-rolled stock batch: picks a handful of random
// items (capped by both the upgrade level and how many parts actually exist this refresh)
// and marks them down, up to the upgrade's max percentage.
function applyMarketDiscounts(items){
  const desired = getMarketDiscountCount();
  const maxPct = getMarketDiscountMaxPct();
  if(desired<=0 || maxPct<5 || items.length===0) return;
  const indices = items.map((_,i)=>i).sort(()=>Math.random()-0.5).slice(0, Math.min(desired, items.length));
  indices.forEach(i=>{
    const pct = 5 + Math.floor(Math.random()*(maxPct-5+1));
    const item = items[i];
    item.discountPct = pct;
    item.originalPrice = item.price;
    item.price = Math.max(5, Math.round(item.price * (1 - pct/100)));
  });
}

function generatePartfindrStock(carName){
  if(Math.random() < getPartfindrEmptyChance()) return [];
  const count = 3 + Math.floor(Math.random()*getPartfindrCountRange()); // widens with Surplus
  const items = [];
  for(let i=0;i<count;i++){
    const category = CATEGORIES[Math.floor(Math.random()*CATEGORIES.length)];
    const rarity = RARITIES[weightedIndex(PARTFINDR_RARITY_WEIGHTS)];
    const part = makePart(category, rarity, carName);
    // Direct-search convenience costs a premium over the part's own value.
    const markup = 1.15 + Math.random()*0.35; // 15%-50% above value
    part.price = Math.max(part.value + 5, Math.round(part.value * markup));
    items.push(part);
  }
  applyMarketDiscounts(items);
  return items;
}

// Lazily creates a car's stock the first time it's searched, rather than pre-rolling
// stock for every car in the game up front.
function getPartfindrStock(carName){
  let stock = state.partSearchStock[carName];
  if(!stock){
    stock = { items: generatePartfindrStock(carName), timeLeft: PARTFINDR_REFRESH };
    state.partSearchStock[carName] = stock;
  }
  return stock;
}

function tickPartfindr(dt){
  Object.keys(state.partSearchStock).forEach(carName=>{
    const stock = state.partSearchStock[carName];
    stock.timeLeft -= dt;
    if(stock.timeLeft <= 0){
      stock.items = generatePartfindrStock(carName);
      stock.timeLeft = PARTFINDR_REFRESH;
    }
  });
}

/* ---------------------------------------------------------
   CARS â€” slots, stock parts, dynamic value
   Each car gets ONE SLOT ARRAY PER CATEGORY, sized to its build potential â€”
   a 1-potential car has 1 slot per category, a 5-potential car has 5.
--------------------------------------------------------- */
function initCarSlots(potential, carName){
  const slots = {};
  CATEGORIES.forEach(cat=>{
    const arr = [];
    for(let i=0;i<potential;i++){
      const rarity = weightedCarRarity(potential);
      arr.push({ part: makePart(cat, rarity, carName), installing: null });
    }
    slots[cat] = arr;
  });
  return slots;
}

// The "shell" is what the bare chassis is worth with every part stripped out â€” a fixed
// baseline per potential tier, independent of how lucky the stock-part rolls happen to be.
const SHELL_BASE_BY_POTENTIAL = [150, 400, 900, 1800, 3500];
function shellValueForPotential(potential){
  return SHELL_BASE_BY_POTENTIAL[potential-1];
}

function getCarValue(car){
  let total = car.shellValue;
  CATEGORIES.forEach(cat=>{
    car.slots[cat].forEach(slot=>{
      if(slot.part) total += slot.part.value;
    });
  });
  return Math.max(0, Math.round(total));
}

function getItemValue(l, item){
  return l.type==='car' ? getCarValue(item) : item.value;
}

// Average value of a single rarity roll off a given weight row (aligned to RARITIES order).
function expectedSlotValue(weights){
  const total = weights.reduce((a,b)=>a+b,0);
  const sum = RARITIES.reduce((acc,r,i)=> acc + weights[i]*((r.min+r.max)/2), 0);
  return sum / total;
}

// What a fully-optioned example of this build-potential tier is statistically worth, using
// the ORIGINAL case-pull weight table â€” this is the "build potential" the price tag reflects,
// deliberately independent of CAR_PART_WEIGHTS/what actually gets rolled into the listing.
function expectedPartsValueForPotential(potential){
  return expectedSlotValue(WEIGHTS[potential-1]) * CATEGORIES.length * potential;
}

// Rolls a complete car build (shell + stock parts) up front. The sticker price is based on
// the car's build potential â€” what buyers are really paying for â€” not on the actual parts
// this particular listing happened to roll (those use CAR_PART_WEIGHTS and skew low), so a
// high-end car reliably prices high while its resale value right after purchase takes a real
// hit unless you got lucky or leveled up Quality Pickings.
function rollCarBuild(potential, carName){
  const slots = initCarSlots(potential, carName);
  const shellValue = shellValueForPotential(potential);
  const trueValue = shellValue + expectedPartsValueForPotential(potential);
  const dealerMargin = 1.08 + Math.random()*0.22; // dealer marks up 8%-30% over the build-potential ceiling
  const price = Math.max(shellValue, Math.round((trueValue * dealerMargin) / 25) * 25);
  return { slots, shellValue, price };
}

function generateDealerListings(count){
  const pool = [...CAR_POOL];
  const picks = [];
  for(let i=0;i<count && pool.length>0;i++){
    const idx = Math.floor(Math.random()*pool.length);
    const m = pool.splice(idx,1)[0];
    const build = rollCarBuild(m.potential, m.name);
    picks.push({
      id: state.nextId++,
      name: m.name,
      potential: m.potential,
      bodyStyle: m.bodyStyle,
      price: build.price,
      shellValue: build.shellValue,
      slots: build.slots,
    });
  }
  return picks;
}

/* ---------------------------------------------------------
   CAR SVG ART â€” simple side-profile silhouettes per body style
--------------------------------------------------------- */
