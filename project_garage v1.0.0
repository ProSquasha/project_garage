    <path d="M15,112 L15,92 Q15,80 40,77 L90,70 Q110,52 150,50 L190,52 Q210,54 225,68 L265,74 Q285,80 285,94 L285,112 Z" fill="${color}" stroke="#000" stroke-width="2"/>
    <path d="M185,68 L200,52 L218,52 L222,68 Z" fill="#12141a" stroke="#000" stroke-width="1.5"/>
    ${svgWheelsAndLights()}
  </svg>`;
}
function svgMuscle(color){
  return `<svg viewBox="0 0 300 140" xmlns="http://www.w3.org/2000/svg">
    <path d="M15,112 L15,86 Q15,74 35,70 L90,67 L90,47 L150,44 L150,67 Q220,68 265,70 Q285,74 285,90 L285,112 Z" fill="${color}" stroke="#000" stroke-width="2"/>
    <rect x="100" y="50" width="45" height="17" fill="#12141a" stroke="#000" stroke-width="1.5"/>
    <rect x="188" y="60" width="32" height="6" fill="#00000055"/>
