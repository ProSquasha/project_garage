  </svg>`;
}
const CAR_SVG_BUILDERS = { hatch:svgHatch, coupe:svgCoupe, roadster:svgRoadster, muscle:svgMuscle, super:svgSuper };
function getCarSvg(car){
  const builder = CAR_SVG_BUILDERS[car.bodyStyle] || svgCoupe;
  return builder(car.color || '#b5482a');
}

/* ---------------------------------------------------------
   RENDERING
--------------------------------------------------------- */
const content = document.getElementById('content');

function renderTopbar(){
  document.getElementById('cashVal').textContent = '$'+state.cash.toLocaleString();
  const current = state.cars.find(c=>c.currentProject);
  document.getElementById('carVal').textContent = current ? current.name : 'NONE';
}

function setTab(tab){
  state.activeTab = tab;
  if(tab !== 'market'){
    state.marketDetailId = null;
  } else {
    // Clicking the MARKET nav button always lands back on the PARTFINDR homepage,
    // even if you were mid-search or viewing Your Listings last time you were here.
    state.market.view = 'home';
    state.marketDetailId = null;
  }
  if(tab === 'websites'){
    // Same idea for SITEFINDR: the nav button always returns to the search-results home.
    state.websites.view = 'home';
    state.websites.siteIdx = null;
  }
  if(tab !== 'garage'){ state.workshopCarId = null; workshopActiveCategory = null; }
  document.querySelectorAll('.navbtn').forEach(b=>{
    b.classList.toggle('active', b.dataset.tab===tab);
  });
  render();
}
document.querySelectorAll('.navbtn').forEach(b=>{
  b.addEventListener('click', ()=>setTab(b.dataset.tab));
});

function render(){
  renderTopbar();
  if(state.activeTab==='websites') renderWebsites();
  else if(state.activeTab==='inventory') renderInventory();
  else if(state.activeTab==='market') renderMarket();
  else if(state.activeTab==='garage') renderGarage();
}

function renderDiscountTimerTag(site){
  if(site.upgrades.discount===0) return '';
  const label = site.discounts.length>0 ? 'Refresh in' : 'Discounts in';
  const mins = Math.floor(site.discountTimeLeft/60);
  const secs = Math.floor(site.discountTimeLeft%60).toString().padStart(2,'0');
  return `<span class="discountTimerTag">${label}: ${mins}:${secs}</span>`;
}

/* ---------------------------------------------------------
   SITEFINDR â€” the WEBSITES tab, reskinned as its own mock
   search engine using the same browser-frame shell as PARTFINDR.
--------------------------------------------------------- */
function sitefindrUrl(){
  if(state.websites.view==='site' && state.websites.siteIdx!==null) return WEBSITES[state.websites.siteIdx].url;
  if(state.websites.view==='dealer'){
    const dealer = WEBSITES.find(s=>s.isCarDealer);
    return dealer.url;
  }
  return 'sitefindr.net/results?q=case+sites';
}
function siteFrame(bodyHtml, bookmarks){
  return browserFrame(sitefindrUrl(), bodyHtml, bookmarks);
}

function renderWebsites(){
  if(state.websites.view === 'site' && state.websites.siteIdx !== null){
    renderWebsiteSitePage(state.websites.siteIdx);
    return;
  }
  if(state.websites.view === 'dealer'){
    renderAutoExchangePage();
    return;
  }
  renderWebsitesHome();
}

function renderWebsitesHome(){
  let body = `<div class="sfResultsHead">
    <div class="sfLogo">SITEFINDR</div>
    <div class="sfQuery">Showing results for: <b>case sites near you</b></div>
  </div>
  <div class="sfResultsList">`;
  WEBSITES.forEach((site, wi)=>{
    if(site.isCarDealer){
      body += `<div class="sfResult" onclick="openAutoExchangePage()">
        <div class="sfResultTitle">${site.name}</div>
        <div class="sfResultUrl">${site.url}</div>
        <div class="sfResultDesc">Buy full cars with stock parts already installed â€” lot inventory rotates on a timer.</div>
      </div>`;
      return;
    }
    body += `<div class="sfResult" onclick="openWebsitePage(${wi})">
      <div class="sfResultTitle">${site.name}</div>
      <div class="sfResultUrl">${site.url}</div>
      <div class="sfResultStars">${'â˜…'.repeat(site.stars)}${'â˜†'.repeat(5-site.stars)}</div>
      <div class="sfResultDesc">${site.stars}-star case retailer. Buy category-specific cases, earn Reputation, and unlock Benefits.</div>
    </div>`;
  });
  body += `</div>`;
  content.innerHTML = siteFrame(body);
}

function renderWebsiteSitePage(wi){
  const site = WEBSITES[wi];
  let body = `<button class="backBtn" onclick="backToSitefindr()">â† BACK TO SITEFINDR</button>`;
  body += `<div class="siteHead">
      <div class="siteHeadLeft"><span class="name">${site.name}</span><span class="url">${site.url}</span></div>
      <div class="siteHeadRight">
        ${renderDiscountTimerTag(site)}
        <span class="repTag">REP ${site.reputation.toLocaleString()}</span>
        <button class="benefitsBtn" onclick="openBenefits(${wi})">BENEFITS</button>
      </div>
    </div>
    <div class="caseGrid">`;
  CATEGORIES.forEach(cat=>{
    const base = CASE_COST[site.stars-1];
    const price = getCasePrice(site, cat);
    const disc = site.discounts.find(d=>d.category===cat);
    const affordable = state.cash >= price;
    body += `<div class="caseCard">
      ${disc ? `<div class="discBadge">${disc.pct}% Off<span class="leftTag">(${disc.usesLeft} LEFT)</span></div>` : ''}
      <div class="stars">${'â˜…'.repeat(site.stars)}${'â˜†'.repeat(5-site.stars)}</div>
      <div class="caseName">${cat} Case</div>
      ${disc
        ? `<div class="price"><span class="strike">$${base.toLocaleString()}</span>$${price.toLocaleString()}</div>`
        : `<div class="price">$${price.toLocaleString()}</div>`
      }
      <button class="buyBtn" ${affordable?'':'disabled'} onclick="buyCase(${wi}, '${cat}')">OPEN CASE</button>
    </div>`;
  });
  body += `</div>`;
  content.innerHTML = siteFrame(body, BOOKMARKS_SHOP);
}

function renderAutoExchangePage(){
  const wi = WEBSITES.findIndex(s=>s.isCarDealer);
  const site = WEBSITES[wi];
  const mins = Math.floor(site.refreshTime/60);
  const secs = Math.floor(site.refreshTime%60).toString().padStart(2,'0');
  let body = `<button class="backBtn" onclick="backToSitefindr()">â† BACK TO SITEFINDR</button>`;
  body += `<div class="siteHead">
      <div class="siteHeadLeft"><span class="name">${site.name}</span><span class="url">${site.url}</span></div>
      <div class="siteHeadRight"><span class="repTag">LOT REFRESH ${mins}:${secs}</span></div>
    </div>
    <div class="caseGrid">`;
  if(site.listings.length===0){
    body += `<div class="emptyMsg">Lot is empty. New inventory incoming.</div>`;
  } else {
    site.listings.forEach(c=>{
      const affordable = state.cash >= c.price;
      body += `<div class="caseCard">
        <div class="stars">${'â˜…'.repeat(c.potential)}${'â˜†'.repeat(5-c.potential)}</div>
        <div class="caseName">${c.name}</div>
        <div class="price">$${c.price.toLocaleString()}</div>
        <div class="priceNote">stock parts included, priced above resale</div>
        <button class="buyBtn" ${affordable?'':'disabled'} onclick="buyDealerCar(${wi}, ${c.id})">ACQUIRE</button>
      </div>`;
    });
  }
  body += `</div>`;
  content.innerHTML = siteFrame(body, BOOKMARKS_DEALER);
}

function openWebsitePage(wi){
  state.websites.view = 'site';
  state.websites.siteIdx = wi;
  render();
}
function openAutoExchangePage(){
  state.websites.view = 'dealer';
  state.websites.siteIdx = null;
  render();
}
function backToSitefindr(){
  state.websites.view = 'home';
  state.websites.siteIdx = null;
  render();
}

function renderInventory(){
  let html = `<h2 class="pagetitle">PART INVENTORY</h2><p class="pagesub">${state.inventory.length} items owned. Locked items pin to the front of the list. List unlocked items for sale on the Market.</p>`;
  html += `<div class="invFilters">`;
  INVENTORY_FILTERS.forEach(f=>{
    html += `<button class="filterBtn ${state.invFilter===f?'active':''}" onclick="setInvFilter('${f}')">${f}</button>`;
  });
  html += `</div>`;

  // Second filter row: narrow down to parts that fit one specific car model â€” handy when
  // you're hunting for what you still need to finish a build rather than just flipping loot.
  const ownedModels = [...new Set(state.cars.map(c=>c.name))];
  html += `<div class="invFilters" style="margin-top:-6px;">
    <button class="filterBtn ${state.invCarFilter==='All'?'active':''}" onclick="setInvCarFilter('All')">ALL MODELS</button>`;
  ownedModels.forEach(m=>{
    html += `<button class="filterBtn ${state.invCarFilter===m?'active':''}" onclick="setInvCarFilter('${jsAttrEscape(m)}')">FITS: ${m}</button>`;
  });
  html += `</div>`;

  const shown = state.inventory.filter(p =>
    (state.invFilter==='All' || p.category===state.invFilter) &&
    (state.invCarFilter==='All' || p.kind==='decal' || p.car===state.invCarFilter)
  );
  if(shown.length===0){
    html += `<div class="emptyMsg">${state.inventory.length===0 ? 'No items here yet. Buy a case from WEBSITES.' : 'No items match these filters.'}</div>`;
  } else {
    html += `<div class="partGrid">`;
    shown.forEach(p=>{
      const listedCount = state.listings.length;
      const canList = !p.locked && !p.listed && listedCount < 5;
      if(p.kind==='decal'){
        const color = DECAL_STAR_COLORS[p.starLevel-1];
        html += `<div class="partCard" style="--rarity:${color}">
          ${p.locked?'<div class="lockIcon">ðŸ”’</div>':''}
          <div class="tag">DECAL ${'â˜…'.repeat(p.starLevel)}</div>
          <div class="demojiBig">${p.emoji}</div>
          <div class="pname" style="text-align:center;">${p.name}</div>
          <div class="pcat" style="text-align:center;">Decals</div>
          <div class="pval" style="text-align:center;">$${p.value.toLocaleString()}</div>
          <div class="cardBtns">
            <button class="smallBtn ${p.locked?'on':''}" onclick="toggleLock(${p.id})">${p.locked?'UNLOCK':'LOCK'}</button>
            <button class="smallBtn" ${(canList)?'':'disabled'} onclick="listForSale(${p.id})">${p.listed?'LISTED':'LIST FOR SALE'}</button>
          </div>
        </div>`;
      } else {
        const r = rarityByKey(p.rarityKey);
        const fitsOwnedCar = state.cars.some(c=>c.name===p.car);
        html += `<div class="partCard" style="--rarity:${r.color}">
          ${p.locked?'<div class="lockIcon">ðŸ”’</div>':''}
          <div class="tag">${r.name}</div>
          <div class="pname">${p.name}</div>
          <div class="pcat">${p.category}</div>
          <div class="pval">$${p.value.toLocaleString()}</div>
          <div class="pcar" style="${fitsOwnedCar?'color:var(--good);':''}">FITS: <b>${p.car}</b>${fitsOwnedCar?' âœ“':''}</div>
          <div class="cardBtns">
            <button class="smallBtn ${p.locked?'on':''}" onclick="toggleLock(${p.id})">${p.locked?'UNLOCK':'LOCK'}</button>
            <button class="smallBtn" ${(canList)?'':'disabled'} onclick="listForSale(${p.id})">${p.listed?'LISTED':'LIST FOR SALE'}</button>
          </div>
        </div>`;
      }
    });
    html += `</div>`;
  }
  content.innerHTML = html;
}

function setInvFilter(f){ state.invFilter = f; render(); }
function setInvCarFilter(m){ state.invCarFilter = m; render(); }



function getListingItem(l){
  return l.type==='car' ? state.cars.find(c=>c.id===l.refId) : state.inventory.find(p=>p.id===l.refId);
}

function renderMarket(){
  if(state.market.view === 'listings'){
    if(state.marketDetailId !== null){
      renderMarketDetail(state.marketDetailId);
      return;
    }
    renderYourListings();
    return;
  }
  if(state.market.view === 'results'){ renderPartfindrResults(); return; }
  if(state.market.view === 'noresults'){ renderPartfindrNoResults(); return; }
  renderPartfindrHome();
}

/* ---------------------------------------------------------
   PARTFINDR â€” retro browser chrome shared across all views
--------------------------------------------------------- */
function slugify(s){
  return String(s).toLowerCase().replace(/'/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');
}
function partfindrUrl(){
  if(state.market.view==='results') return `partfindr.net/search?car=${slugify(state.market.resultsCar||'')}`;
  if(state.market.view==='noresults') return `partfindr.net/search?car=${slugify(state.market.lastQuery||'')}`;
  if(state.market.view==='listings') return `partfindr.net/account/listings`;
  return 'partfindr.net/';
}

// Decorative, unclickable bookmark-bar text â€” varies a little by page "type" so every
// mock website doesn't read as an identical reskin of the same search engine.
const BOOKMARKS_SEARCH = ['â˜… Home','Bookmarks','History','Downloads','Settings','Help'];
const BOOKMARKS_SHOP = ['Deals','Reviews','Track Order','Support'];
const BOOKMARKS_DEALER = ['Inventory','Financing','Trade-In','Support'];
const BOOKMARKS_ACCOUNT = ['Orders','Messages','Settings','Help'];

// Shared "browser window" shell: nav arrows + URL bar + bookmarks bar, all wrapping the
// actual page content in one rectangle â€” reused by both PARTFINDR and the WEBSITES tab.
function browserFrame(url, bodyHtml, bookmarks){
  const marks = bookmarks || BOOKMARKS_SEARCH;
  return `<div class="pfBrowserChrome">
    <div class="pfChromeTop">
      <span class="pfNavArrows">â—€ â–¶ âŸ³</span>
      <div class="pfUrlBar">${url}</div>
    </div>
    <div class="pfBookmarksBar">${marks.map(m=>`<span>${m}</span>`).join('')}</div>
    <div class="pfPage">${bodyHtml}</div>
  </div>`;
}
function pfFrame(bodyHtml, bookmarks){
  return browserFrame(partfindrUrl(), bodyHtml, bookmarks);
}

function renderPartfindrHome(){
  const body = `<div class="pfHome">
    <div class="pfLogo" onclick="goPartfindrHome()">PARTFINDR</div>
    <div class="pfTagline">FIND THE PART. FIND THE FIT.</div>
    <div class="pfSearchWrap">
      <input type="text" id="pfSearchInput" class="pfSearchInput" placeholder="Search a car model, e.g. '99 Supra" value="${escapeHtml(state.market.searchText)}" oninput="pfHandleInput(this.value)" onkeydown="pfHandleKeydown(event)" autocomplete="off" spellcheck="false">
      <div id="pfAutofillList" class="pfAutofillList"></div>
    </div>
    <div class="mktRepTag">MARKET REP <b>${state.market.reputation.toLocaleString()}</b></div>
    <div class="pfBtnRow">
      <button class="pfActionBtn" onclick="openYourListings()">YOUR LISTINGS</button>
      <button class="pfActionBtn" onclick="openMarketRepModal()">BENEFITS</button>
    </div>
    <div class="pfHint">Search any car model in the game to browse parts sellers currently have in stock for it.</div>
  </div>`;
  content.innerHTML = pfFrame(body);
  const input = document.getElementById('pfSearchInput');
  if(input){
    input.focus();
    const len = input.value.length;
    input.setSelectionRange(len, len);
    pfRenderAutofill(input.value);
  }
}

function renderPartfindrNoResults(){
  const body = `<div class="pfNoResults">
    <div class="big">No results for "${escapeHtml(state.market.lastQuery)}"</div>
    <p>PARTFINDR only indexes car models that actually exist in the world. Check your spelling, or search again with the autofill suggestions.</p>
    <button class="pfActionBtn" style="margin-top:18px;" onclick="goPartfindrHome()">NEW SEARCH</button>
  </div>`;
  content.innerHTML = pfFrame(body);
}

function renderPartfindrResults(){
  const carName = state.market.resultsCar;
  const stock = getPartfindrStock(carName);
  let body = `<button class="backBtn" onclick="goPartfindrHome()">â† NEW SEARCH</button>`;
  body += `<h2 class="pagetitle">RESULTS FOR: ${carName.toUpperCase()}</h2>`;
  const mins = Math.floor(Math.max(0,stock.timeLeft)/60);
  const secs = Math.floor(Math.max(0,stock.timeLeft)%60).toString().padStart(2,'0');
  const discountedCount = stock.items.filter(p=>p.discountPct).length;
  body += `<p class="pfRestock">Stock refreshes in ${mins}:${secs} Â· prices run above market value for direct-search convenience${discountedCount>0 ? ` Â· ${discountedCount} discounted item${discountedCount!==1?'s':''} this refresh` : ''}</p>`;

  body += `<div class="invFilters">`;
  PARTFINDR_FILTERS.forEach(f=>{
    body += `<button class="filterBtn ${state.market.resultsFilter===f?'active':''}" onclick="setPfResultsFilter('${f}')">${f}</button>`;
  });
  body += `</div>`;

  const shown = stock.items.filter(p => state.market.resultsFilter==='All' || p.category===state.market.resultsFilter);

  if(stock.items.length===0){
    body += `<div class="emptyMsg">No sellers currently listing parts for the ${carName}. Check back after the next refresh.</div>`;
  } else if(shown.length===0){
    body += `<div class="emptyMsg">No ${state.market.resultsFilter} parts in this refresh. Try another category or check back later.</div>`;
  } else {
    body += `<div class="partGrid">`;
    shown.forEach(p=>{
      const r = rarityByKey(p.rarityKey);
      const affordable = state.cash >= p.price;
      const priceLine = p.discountPct
        ? `<span class="strike">$${p.originalPrice.toLocaleString()}</span>$${p.price.toLocaleString()}`
        : `$${p.price.toLocaleString()}`;
      body += `<div class="partCard" style="--rarity:${r.color}">
        ${p.discountPct ? `<div class="discBadge">${p.discountPct}% Off</div>` : ''}
        <div class="tag">${r.name}</div>
        <div class="pname">${p.name}</div>
        <div class="pcat">${p.category}</div>
        <div class="pval">${priceLine} <span style="color:var(--dim);font-size:9px;">(val. $${p.value.toLocaleString()})</span></div>
        <div class="pcar">FITS: <b>${p.car}</b></div>
        <button class="buyBtn" ${affordable?'':'disabled'} onclick="buyPartfindrPart(${p.id})">BUY</button>
      </div>`;
    });
    body += `</div>`;
  }
  content.innerHTML = pfFrame(body, BOOKMARKS_SHOP);
}

function renderYourListings(){
  let body = `<button class="backBtn" onclick="backToPartfindr()">â† BACK TO PARTFINDR</button>`;
  body += `<h2 class="pagetitle">YOUR LISTINGS</h2><p class="pagesub">Listings run for 5 minutes and attract random offers. Open a listing to accept or decline offers.</p>`;
  body += `<div class="mktRepTag">MARKET REP <b>${state.market.reputation.toLocaleString()}</b></div>`;
  body += `<div id="marketSlots">SLOTS USED: ${state.listings.length} / 5</div>`;

  if(state.listings.length===0){
    body += `<div class="emptyMsg">No active listings. List a part or car from PART INVENTORY / GARAGE.</div>`;
  } else {
    body += `<div class="marketGrid">`;
    state.listings.forEach(l=>{
      const item = getListingItem(l);
      if(!item) return;
      const value = getItemValue(l, item);
      const mins = Math.floor(l.timeLeft/60);
      const secs = Math.floor(l.timeLeft%60).toString().padStart(2,'0');
      let color, tagLabel, subLine, carLine = '';
      if(l.type==='car'){
        color = '#f2b705'; tagLabel = 'CAR';
        subLine = `Build Potential ${item.potential}/5 Â· est. $${value.toLocaleString()}`;
      } else if(item.kind==='decal'){
        color = DECAL_STAR_COLORS[item.starLevel-1]; tagLabel = 'DECAL';
        subLine = `${'â˜…'.repeat(item.starLevel)} collector item Â· est. $${value.toLocaleString()}`;
      } else {
        const r = rarityByKey(item.rarityKey);
        color = r.color; tagLabel = r.name;
        subLine = `${item.category} Â· est. $${value.toLocaleString()}`;
        carLine = `<div class="lcar">FITS: <b>${item.car}</b></div>`;
      }
      body += `<div class="listingCard" style="--rarity:${color}" onclick="openMarketDetail(${l.id})">
        <span class="timer">${mins}:${secs}</span>
        <div class="tag" style="display:inline-block;padding:2px 6px;font-size:9px;background:${color};color:#0a0a0a;font-weight:bold;">${tagLabel}</div>
        <div class="pname" style="margin-top:6px;">${item.name}</div>
        <div class="pcat">${subLine}</div>
        ${carLine}
        <div class="offCount">${l.offers.length} offer${l.offers.length!==1?'s':''}</div>
      </div>`;
    });
    body += `</div>`;
  }
  content.innerHTML = pfFrame(body, BOOKMARKS_ACCOUNT);
}

function renderMarketDetail(listingId){
  const l = state.listings.find(l=>l.id===listingId);
  if(!l){ state.marketDetailId = null; renderMarket(); return; }
  const item = getListingItem(l);
  if(!item){ state.marketDetailId = null; renderMarket(); return; }

  const value = getItemValue(l, item);
  const mins = Math.floor(l.timeLeft/60);
  const secs = Math.floor(l.timeLeft%60).toString().padStart(2,'0');
  let color, metaLine;
  if(l.type==='car'){
    color = '#f2b705';
    metaLine = `Build Potential ${item.potential}/5 Â· Est. value $${value.toLocaleString()} (includes installed parts) Â· Listing closes in ${mins}:${secs}`;
  } else if(item.kind==='decal'){
    color = DECAL_STAR_COLORS[item.starLevel-1];
    metaLine = `${'â˜…'.repeat(item.starLevel)} Decal Â· Est. value $${value.toLocaleString()} Â· Listing closes in ${mins}:${secs}`;
  } else {
    const r = rarityByKey(item.rarityKey);
    color = r.color;
    metaLine = `${item.category} Â· ${r.name} Â· Fits: ${item.car} Â· Est. value $${value.toLocaleString()} Â· Listing closes in ${mins}:${secs}`;
  }

  let html = `<button class="backBtn" onclick="closeMarketDetail()">â† BACK TO MARKET</button>`;
  html += `<h2 class="pagetitle" style="color:${color}">${item.name.toUpperCase()}</h2>`;
  html += `<div class="detailMeta">${metaLine}</div>`;

  if(l.offers.length===0){
    html += `<div class="emptyMsg">No offers yet. Check back soon.</div>`;
  } else {
    l.offers.slice().sort((a,b)=>b.amount-a.amount).forEach(o=>{
      const aboveMarket = o.amount > value;
      html += `<div class="offerRow">
        <span class="amt">${o.buyer} â€” $${o.amount.toLocaleString()}${aboveMarket?'<span class="aboveTag">ABOVE VALUE</span>':''}</span>
        <span class="offerBtns">
          <button class="acceptBtn" onclick="acceptOffer(${l.id}, ${o.id})">ACCEPT</button>
          <button class="declineBtn" onclick="declineOffer(${l.id}, ${o.id})">DECLINE</button>
        </span>
      </div>`;
    });
  }
  content.innerHTML = html;
}

function renderGarage(){
  if(state.workshopCarId !== null){
    const car = state.cars.find(c=>c.id===state.workshopCarId);
    if(car){ renderWorkshop(car); return; }
    state.workshopCarId = null;
  }

  let html = `<h2 class="pagetitle">GARAGE</h2><p class="pagesub">Your owned cars. Click one to open the Workshop, or list it on the Market to sell.</p>`;
  if(state.cars.length===0){
    html += `<div class="emptyMsg">No cars owned. Buy one from AUTO EXCHANGE in WEBSITES.</div>`;
  } else {
    html += `<div class="carGrid">`;
    state.cars.forEach(c=>{
      const pct = c.potential*20;
      const canList = !c.listed && state.listings.length < 5;
      html += `<div class="carCard ${c.currentProject?'currentCar':''}" onclick="openWorkshop(${c.id})">
        <div class="cname">${c.name}</div>
        <div class="cmeta">Build Potential: ${c.potential} / 5 â€” ${c.potential} slot(s) per category</div>
        <div class="potBar"><div style="width:${pct}%"></div></div>
        <div class="cmeta">Est. Value: $${getCarValue(c).toLocaleString()}</div>
        ${c.currentProject ? `<span class="ownedTag">â˜… CURRENT PROJECT</span>` : ''}
        <div class="cardBtns">
          ${!c.currentProject ? `<button class="smallBtn" onclick="event.stopPropagation(); selectCar(${c.id})">SET CURRENT</button>` : ''}
          <button class="smallBtn" ${(canList)?'':'disabled'} onclick="event.stopPropagation(); listCarForSale(${c.id})">${c.listed?'LISTED':'LIST FOR SALE'}</button>
        </div>
      </div>`;
    });
    html += `</div>`;
  }
  content.innerHTML = html;
}

function renderWorkshop(car){
  let html = `<button class="backBtn" onclick="closeWorkshop()">â† BACK TO GARAGE</button>`;
  html += `<h2 class="pagetitle">${car.name.toUpperCase()} â€” WORKSHOP</h2>`;
  html += `<p class="pagesub">Est. value with current build: $${getCarValue(car).toLocaleString()} (bare shell worth $${car.shellValue.toLocaleString()}). Build Potential ${car.potential} gives this car ${car.potential} slot(s) per category. Select a category below to view its slots.</p>`;

  html += `<div class="slotPanel">`;
  if(workshopActiveCategory && car.slots[workshopActiveCategory]){
    const cat = workshopActiveCategory;
    const slotsArr = car.slots[cat];
    const filled = slotsArr.filter(s=>s.part).length;
    html += `<div class="slotPanelHead">${cat.toUpperCase()} â€” ${filled}/${slotsArr.length} INSTALLED</div>`;
    html += `<div class="slotPanelGrid">`;
    slotsArr.forEach((slot, idx)=>{
      if(slot.installing){
        const mins = Math.floor(slot.installing.timeLeft/60);
        const secs = Math.floor(slot.installing.timeLeft%60).toString().padStart(2,'0');
        html += `<div class="slotCardFlat installing">
          <div class="slotInstalling">INSTALLINGâ€¦<br>${mins}:${secs}</div>
        </div>`;
      } else if(slot.part){
        const r = rarityByKey(slot.part.rarityKey);
        html += `<div class="slotCardFlat" style="--rarity:${r.color}">
          <button class="slotRemove" onclick="uninstallPart(${car.id}, '${cat}', ${idx})">Ã—</button>
          <div class="tag">${r.name}</div>
          <div class="pname">${slot.part.name}</div>
          <div class="pval">$${slot.part.value.toLocaleString()}</div>
          <div class="scar">FITS: <b>${slot.part.car}</b></div>
        </div>`;
      } else {
        html += `<div class="slotCardFlat empty" onclick="openInstallPicker(${car.id}, '${cat}', ${idx})">
          <div class="slotEmptyLabel">+ EMPTY SLOT</div>
        </div>`;
      }
    });
    html += `</div>`;
  } else {
    html += `<div class="emptyMsg">Select a part category below to view and edit its slots.</div>`;
  }
  html += `</div>`;

  html += `<div class="workshopStage">`;
  html += `<svg class="stageLines" viewBox="0 0 100 100" preserveAspectRatio="none">`;
  WORKSHOP_LAYOUT.forEach(pos=>{
    html += `<line x1="${pos.x}" y1="${pos.y}" x2="${pos.tx}" y2="${pos.ty}" stroke="#55584a" stroke-width="0.4" />`;
  });
  html += `</svg>`;
  html += `<div class="stageCarWrap">${getCarSvg(car)}</div>`;

  WORKSHOP_LAYOUT.forEach(pos=>{
    const cat = pos.cat;
    const slotsArr = car.slots[cat];
    const filled = slotsArr.filter(s=>s.part).length;
    const installing = slotsArr.filter(s=>s.installing).length;
    const active = workshopActiveCategory===cat;
    html += `<div class="categoryTab ${active?'active':''}" style="left:${pos.x}%;top:${pos.y}%;" onclick="selectWorkshopCategory('${cat}')">
      <div class="tabName">${cat}</div>
      <div class="tabCount">${filled}/${slotsArr.length}${installing?` Â· ${installing} inst.`:''}</div>
    </div>`;
  });

  html += `</div>`;
  content.innerHTML = html;
}

/* ---------------------------------------------------------
   ACTIONS â€” cases & reveal
--------------------------------------------------------- */
function buyCase(siteIdx, category){
  const site = WEBSITES[siteIdx];
  const price = getCasePrice(site, category);
  if(state.cash < price) return;
  state.cash -= price;

  // Buying a discounted case only spends one of its uses â€” it does NOT reroll the
  // discount batch or reset the shared refresh timer. Only running out of uses (or
  // the shared timer expiring) removes/rerolls a discount.
  const dIdx = site.discounts.findIndex(d=>d.category===category);
  if(dIdx !== -1){
    site.discounts[dIdx].usesLeft -= 1;
    if(site.discounts[dIdx].usesLeft <= 0){
      site.discounts.splice(dIdx,1);
    }
  }

  site.reputation += Math.round(10*site.stars);

  const result = rollCasePull(site, category);
  state.inventory.push(result.mainPart);
  result.extraParts.forEach(p=>state.inventory.push(p));
  if(result.decal) state.inventory.push(result.decal);

  render();
  startCaseScroll(result);
}

function buyDealerCar(siteIdx, carId){
  const site = WEBSITES[siteIdx];
  const idx = site.listings.findIndex(c=>c.id===carId);
  if(idx===-1) return;
  const c = site.listings[idx];
  if(state.cash < c.price) return;
  state.cash -= c.price;
  site.listings.splice(idx,1);
  state.cars.push({
    id: state.nextId++,
    name: c.name,
    potential: c.potential,
    bodyStyle: c.bodyStyle,
    color: CAR_COLORS[Math.floor(Math.random()*CAR_COLORS.length)],
    currentProject: state.cars.length===0,
    listed: false,
    shellValue: c.shellValue,
    slots: c.slots, // exact same build shown on the lot â€” the price you paid already reflects this
  });
  render();
  showToast(`Acquired ${c.name}!`);
}

/* --- Case-opening horizontal scroll reveal --- */
function startCaseScroll(result){
  const track = document.getElementById('scrollTrack');
  const bg = document.getElementById('scrollBg');
  track.innerHTML = '';
  track.style.transition = 'none';
  track.style.transform = 'translateX(0px)';

  const cardW = 110, gap = 12, step = cardW + gap;
  const totalCards = 36;
  const winIndex = 28; // land near the end so there's a long scroll to slow down through
  const winRarity = rarityByKey(result.mainPart.rarityKey);

  for(let i=0;i<totalCards;i++){
    const card = document.createElement('div');
    card.className = 'scrollCard';
    if(i===winIndex){
      card.style.setProperty('--rarity', winRarity.color);
      card.textContent = '?';
      if(result.decal){
        const badge = document.createElement('span');
        badge.className = 'decalBadge';
        badge.textContent = 'â˜…';
        card.appendChild(badge);
      }
    } else {
      const r = RARITIES[Math.floor(Math.random()*RARITIES.length)];
      card.style.setProperty('--rarity', r.color);
      card.textContent = '?';
    }
    track.appendChild(card);
  }

  bg.classList.add('show');

  requestAnimationFrame(()=>{
    const viewportW = document.getElementById('scrollViewport').clientWidth;
    const target = -(winIndex*step + cardW/2 - viewportW/2);
    requestAnimationFrame(()=>{
      track.style.transition = 'transform 4.2s cubic-bezier(0.1,0.7,0.15,1)';
      track.style.transform = `translateX(${target}px)`;
    });
  });

  track.addEventListener('transitionend', function onDone(){
    track.removeEventListener('transitionend', onDone);
    bg.classList.remove('show');
    showRevealResult(result);
  }, { once:true });
}

function showReveal(part){
  const r = rarityByKey(part.rarityKey);
  const bg = document.getElementById('revealBg');
  const card = document.getElementById('revealCard');
  card.style.setProperty('--rarity', r.color);
  document.getElementById('revTag').textContent = r.name.toUpperCase();
  document.getElementById('revTag').style.background = r.color;
  document.getElementById('revName').textContent = part.name;
  document.getElementById('revCat').textContent = part.category;
  document.getElementById('revVal').textContent = 'Est. Value $'+part.value.toLocaleString();
  document.getElementById('revCar').innerHTML = 'FITS: <b>'+part.car+'</b>';
  bg.classList.add('show');
  card.classList.remove('pop');
  requestAnimationFrame(()=>requestAnimationFrame(()=>card.classList.add('pop')));
}

function showRevealResult(result){
  showReveal(result.mainPart);
  const extras = document.getElementById('revealExtras');
  let html = '';
  result.extraParts.forEach(p=>{
    const r = rarityByKey(p.rarityKey);
    html += `<div class="revealExtraRow"><span style="color:${r.color}">BONUS Â· ${r.name}</span><span>${p.name} â€” $${p.value.toLocaleString()}<br><span style="color:var(--dim);font-size:10px;">FITS: ${p.car}</span></span></div>`;
  });
  if(result.decal){
    const d = result.decal;
    html += `<div class="decalChip" style="--rarity:${DECAL_STAR_COLORS[d.starLevel-1]}">
      <span class="demoji">${d.emoji}</span>
      <span>
        <div>${d.name}</div>
        <div class="dstars">${'â˜…'.repeat(d.starLevel)}${'â˜†'.repeat(5-d.starLevel)} DECAL Â· $${d.value.toLocaleString()}</div>
      </span>
    </div>`;
  }
  extras.innerHTML = html;
}

function closeReveal(){
  document.getElementById('revealBg').classList.remove('show');
  document.getElementById('revealExtras').innerHTML = '';
}

/* ---------------------------------------------------------
   ACTIONS â€” inventory / garage / workshop
--------------------------------------------------------- */
function toggleLock(id){
  const idx = state.inventory.findIndex(p=>p.id===id);
  if(idx===-1) return;
  const p = state.inventory[idx];
  p.locked = !p.locked;
  if(p.locked){
    // pin locked items to the top/left of the list
    state.inventory.splice(idx,1);
    state.inventory.unshift(p);
  }
  render();
}

function listForSale(id){
  const p = state.inventory.find(p=>p.id===id);
  if(!p || p.locked || p.listed) return;
  if(state.listings.length >= 5) return;
  p.listed = true;
  state.listings.push({ id: state.nextId++, type:'part', refId: p.id, timeLeft: 300, offers: [] });
  render();
}

function selectCar(id){
  state.cars.forEach(c=>{ c.currentProject = (c.id===id); });
  render();
}

function listCarForSale(id){
  const c = state.cars.find(c=>c.id===id);
  if(!c || c.listed) return;
  if(state.listings.length >= 5) return;
  c.listed = true;
  state.listings.push({ id: state.nextId++, type:'car', refId: c.id, timeLeft: 300, offers: [] });
  render();
}

function openWorkshop(carId){
  state.workshopCarId = carId;
  workshopActiveCategory = null;
  render();
}
function closeWorkshop(){
  state.workshopCarId = null;
  workshopActiveCategory = null;
  render();
}

function selectWorkshopCategory(cat){
  workshopActiveCategory = cat;
  render();
}

function openInstallPicker(carId, category, slotIndex){
  installPicker = { carId, category, slotIndex };
  renderInstallPicker();
  document.getElementById('installModalBg').classList.add('show');
}
function closeInstallPicker(){
  document.getElementById('installModalBg').classList.remove('show');
  installPicker = null;
}
function renderInstallPicker(){
  const { carId, category } = installPicker;
  const car = state.cars.find(c=>c.id===carId);
  document.getElementById('installModalTitle').textContent = `INSTALL â€” ${category.toUpperCase()}`;

  const categoryMatches = state.inventory.filter(p => p.category===category && p.kind!=='decal' && !p.listed);
  const eligible = categoryMatches.filter(p => p.car === car.name);
  const incompatibleCount = categoryMatches.length - eligible.length;

  let sub = `${eligible.length} compatible part(s) for ${car.name}`;
  if(incompatibleCount > 0) sub += ` Â· ${incompatibleCount} in inventory won't fit this model`;
  document.getElementById('installModalSub').textContent = sub;

  let html = '';
  if(eligible.length===0){
    html = `<div class="emptyMsg">No ${category} parts in inventory fit the ${car.name}.${incompatibleCount>0?` (${incompatibleCount} on hand fit other models.)`:''}</div>`;
  } else {
    eligible.forEach(p=>{
      const r = rarityByKey(p.rarityKey);
      const time = INSTALL_TIME_BY_RARITY[r.key];
      const timeLabel = `${Math.floor(time/60)}m ${time%60}s`;
      html += `<div class="offerRow">
        <span class="amt" style="color:${r.color};min-width:90px;">${r.name}</span>
        <span style="flex:1;margin:0 10px;">${p.name} â€” $${p.value.toLocaleString()}<br><span style="color:var(--dim);font-size:10px;">FITS: ${p.car}</span></span>
        <button class="acceptBtn" onclick="startInstall(${installPicker.carId}, '${category}', ${installPicker.slotIndex}, ${p.id})">INSTALL (${timeLabel})</button>
      </div>`;
    });
  }
  document.getElementById('installModalBody').innerHTML = html;
}

function startInstall(carId, category, slotIndex, partId){
  const car = state.cars.find(c=>c.id===carId);
  if(!car) return;
  const slotsArr = car.slots[category];
  const slot = slotsArr && slotsArr[slotIndex];
  if(!slot || slot.part || slot.installing) return;
  const idx = state.inventory.findIndex(p=>p.id===partId);
  if(idx===-1) return;
  const part = state.inventory[idx];
  if(part.category !== category || part.listed || part.car !== car.name) return;

  state.inventory.splice(idx,1);
  const rarity = rarityByKey(part.rarityKey);
  const time = INSTALL_TIME_BY_RARITY[rarity.key];
  slot.installing = { part, timeLeft: time, totalTime: time };

  closeInstallPicker();
  render();
}

function uninstallPart(carId, category, slotIndex){
  const car = state.cars.find(c=>c.id===carId);
  if(!car) return;
  const slotsArr = car.slots[category];
  const slot = slotsArr && slotsArr[slotIndex];
  if(!slot || !slot.part) return;
  state.inventory.push(slot.part);
  slot.part = null;
  render();
}

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.display = 'block';
  clearTimeout(t._hideTimer);
  t._hideTimer = setTimeout(()=>{ t.style.display='none'; }, 2200);
}

/* ---------------------------------------------------------
   WEBSITE BENEFITS MODAL
--------------------------------------------------------- */
function openBenefits(wi){
  benefitsSiteIdx = wi;
  renderBenefits();
  document.getElementById('benefitsModalBg').classList.add('show');
}
function closeBenefits(){
  document.getElementById('benefitsModalBg').classList.remove('show');
  benefitsSiteIdx = null;
}

function getUpgradeEffectText(site, key){
  if(key==='luck') return `Current reroll-for-better chance: ${(getLuckChance(site)*100).toFixed(1)}%`;
  if(key==='discount') return site.upgrades.discount===0
    ? 'Locked â€” upgrade once to start seeing discounted cases.'
    : `${getDiscountCount(site)} discount(s) per 5-minute cycle, up to ${getDiscountMaxPct(site).toFixed(0)}% off, each good for 1-5 uses`;
  if(key==='bogof') return site.upgrades.bogof===0
    ? 'Locked â€” upgrade once to unlock multi-item pulls.'
    : `${(getBogofChance(site)*100).toFixed(1)}% chance of extra item(s) per case`;
  if(key==='collector') return `Current Decal drop chance: ${((BASE_DECAL_CHANCE+getCollectorBoost(site))*100).toFixed(1)}%`;
  return '';
}

function renderBenefits(){
  const site = WEBSITES[benefitsSiteIdx];
  document.getElementById('benefitsTitle').textContent = `${site.name} BENEFITS`;
  document.getElementById('benefitsSub').textContent = `Reputation: ${site.reputation.toLocaleString()} Â· ${site.stars}-Star Site`;
  let html = '';
  UPGRADE_DEFS.forEach(def=>{
    const level = site.upgrades[def.key];
    const maxed = level >= 5;
    const cost = maxed ? null : getUpgradeCost(site.stars, level);
    html += `<div class="upgradeRow">
      <div class="uHead"><span class="uName">${def.label}</span><span class="uLevel">LV ${level}/5</span></div>
      <div class="uDesc">${def.desc}</div>
      <div class="uEffect">${getUpgradeEffectText(site, def.key)}</div>
      <button class="upgradeBtn" ${(!maxed && site.reputation>=cost)?'':'disabled'} onclick="upgradeSite('${def.key}')">${maxed?'MAXED':'UPGRADE â€” '+cost.toLocaleString()+' REP'}</button>
    </div>`;
  });
  document.getElementById('benefitsBody').innerHTML = html;
}

function upgradeSite(key){
  const site = WEBSITES[benefitsSiteIdx];
  const level = site.upgrades[key];
  if(level >= 5) return;
  const cost = getUpgradeCost(site.stars, level);
  if(site.reputation < cost) return;
  site.reputation -= cost;
  site.upgrades[key] = level+1;

  if(key==='discount'){
    // Leveling up starts a fresh batch immediately, on a fresh 5-minute cycle.
    site.discounts = generateDiscountBatch(site);
    site.discountTimeLeft = 300;
  }

  renderBenefits();
  render(); // refresh the WEBSITES page behind the modal (rep tag, discount badges/timer)
}

/* ---------------------------------------------------------
   MARKET REPUTATION MODAL
--------------------------------------------------------- */
function openMarketRepModal(){
  renderMarketRepUpgrades();
  document.getElementById('marketRepModalBg').classList.add('show');
}
function closeMarketRepModal(){
  document.getElementById('marketRepModalBg').classList.remove('show');
}

function getMarketUpgradeEffectText(key){
  if(key==='hotProduct'){
    return `Current buyer offer boost: +${(getHotProductBoost()*100).toFixed(0)}% (cap +20%). LowballChud is immune.`;
  }
  if(key==='discount'){
    return state.market.upgrades.discount===0
      ? 'Locked â€” upgrade once to start seeing discounted PARTFINDR parts.'
      : `${getMarketDiscountCount()} discounted item(s) per refresh, up to ${getMarketDiscountMaxPct()}% off.`;
  }
  if(key==='surplus'){
    return `Current empty-refresh chance: ${(getPartfindrEmptyChance()*100).toFixed(1)}% Â· part-count range widened by up to ${state.market.upgrades.surplus} per refresh.`;
  }
  if(key==='qualityPickings'){
    return state.market.upgrades.qualityPickings===0
      ? 'Locked â€” upgrade once to start giving purchased cars a chance at better parts.'
      : `${(getQualityPickingsChance()*100).toFixed(0)}% chance per part slot to reroll and keep the better rarity.`;
  }
  return '';
}

function renderMarketRepUpgrades(){
  document.getElementById('marketRepSub').textContent = `Reputation: ${state.market.reputation.toLocaleString()} Â· earned by buying and selling on the Market`;
  let html = '';
  MARKET_UPGRADE_DEFS.forEach(def=>{
    const level = state.market.upgrades[def.key];
    const maxed = level >= 5;
    const cost = maxed ? null : MARKET_UPGRADE_BASE_COSTS[level];
    html += `<div class="upgradeRow">
      <div class="uHead"><span class="uName">${def.label}</span><span class="uLevel" style="color:var(--repblue);">LV ${level}/5</span></div>
      <div class="uDesc">${def.desc}</div>
      <div class="uEffect">${getMarketUpgradeEffectText(def.key)}</div>
      <button class="upgradeBtn" ${(!maxed && state.market.reputation>=cost)?'':'disabled'} onclick="upgradeMarket('${def.key}')">${maxed?'MAXED':'UPGRADE â€” '+cost.toLocaleString()+' REP'}</button>
    </div>`;
  });
  document.getElementById('marketRepBody').innerHTML = html;
}

function upgradeMarket(key){
  const level = state.market.upgrades[key];
  if(level >= 5) return;
  const cost = MARKET_UPGRADE_BASE_COSTS[level];
  if(state.market.reputation < cost) return;
  state.market.reputation -= cost;
  state.market.upgrades[key] = level+1;
  renderMarketRepUpgrades();
  render(); // refresh the PARTFINDR page behind the modal (rep tag)
}

/* ---------------------------------------------------------
   PARTFINDR â€” search, navigation, and direct purchase
--------------------------------------------------------- */
function pfHandleInput(value){
  state.market.searchText = value;
  pfRenderAutofill(value);
}

// Rewrites only the dropdown's own contents via direct DOM access (rather than a full
// render()) so the search input never loses focus or cursor position while typing.
function pfRenderAutofill(value){
  const list = document.getElementById('pfAutofillList');
  if(!list) return;
  const q = value.trim().toLowerCase();
  list.innerHTML = '';
  if(q.length===0){ list.style.display = 'none'; return; }
  const matches = CAR_MODELS.filter(m=>m.toLowerCase().includes(q)).slice(0,8);
  if(matches.length===0){ list.style.display = 'none'; return; }
  list.style.display = 'block';
  matches.forEach(m=>{
    const row = document.createElement('div');
    row.className = 'pfAutofillItem';
    row.textContent = m;
    // mousedown (not click) fires before the input's blur, so selecting a suggestion
    // works even though clicking outside the input would otherwise close the dropdown.
    row.addEventListener('mousedown', (e)=>{ e.preventDefault(); pfSelectCar(m); });
    list.appendChild(row);
  });
}

function pfHandleKeydown(e){
  if(e.key === 'Enter'){
    e.preventDefault();
    pfSearch(e.target.value);
  }
}

function pfSelectCar(carName){
  state.market.searchText = carName;
  pfSearch(carName);
}

function pfSearch(query){
  const q = String(query||'').trim();
  const match = CAR_MODELS.find(m=>m.toLowerCase()===q.toLowerCase());
  if(match){
    openPartfindrResults(match);
  } else {
    state.market.lastQuery = q;
    state.market.view = 'noresults';
    render();
  }
}

function openPartfindrResults(carName){
  state.market.resultsCar = carName;
  state.market.resultsFilter = 'All';
  state.market.view = 'results';
  getPartfindrStock(carName); // ensure a stock batch exists for this car
  render();
}

function setPfResultsFilter(f){
  state.market.resultsFilter = f;
  render();
}

function goPartfindrHome(){
  state.market.view = 'home';
  state.market.searchText = '';
  render();
}

function openYourListings(){
  state.market.view = 'listings';
  render();
}

function backToPartfindr(){
  state.market.view = 'home';
  state.marketDetailId = null;
  render();
}

function buyPartfindrPart(partId){
  const carName = state.market.resultsCar;
  const stock = state.partSearchStock[carName];
  if(!stock) return;
  const idx = stock.items.findIndex(p=>p.id===partId);
  if(idx===-1) return;
  const part = stock.items[idx];
  if(state.cash < part.price) return;
  state.cash -= part.price;
  stock.items.splice(idx,1);
  // Strip the sale-only fields (price, and any discount markers) before it enters inventory.
  const { price, discountPct, originalPrice, ...cleanPart } = part;
  state.inventory.push(cleanPart);
  const repGain = getMarketRepForItem(cleanPart.rarityKey);
  state.market.reputation += repGain;
  render();
  showToast(`Bought ${cleanPart.name} for $${price.toLocaleString()}! (+${repGain} REP)`);
}

/* ---------------------------------------------------------
   MARKET OFFERS SCREEN
--------------------------------------------------------- */
function openMarketDetail(listingId){
  state.marketDetailId = listingId;
  render();
}
function closeMarketDetail(){
  state.marketDetailId = null;
  render();
}

function acceptOffer(listingId, offerId){
  const lIdx = state.listings.findIndex(l=>l.id===listingId);
  if(lIdx===-1) return;
  const l = state.listings[lIdx];
  const offer = l.offers.find(o=>o.id===offerId);
  if(!offer) return;

  const item = getListingItem(l);
  state.cash += offer.amount;

  if(l.type==='car'){
    const cIdx = state.cars.findIndex(c=>c.id===l.refId);
    if(cIdx !== -1){
      const wasCurrent = state.cars[cIdx].currentProject;
      state.cars.splice(cIdx,1); // installed/installing parts sell (or are lost) with the car
      if(wasCurrent && state.cars.length>0) state.cars[0].currentProject = true;
    }
    if(state.workshopCarId === l.refId){ state.workshopCarId = null; workshopActiveCategory = null; }
  } else {
    state.inventory = state.inventory.filter(p=>p.id!==l.refId);
  }

  let repGain = 0;
  if(item){
    if(l.type==='car') repGain = getMarketRepForItem('car', item.potential);
    else if(item.kind==='decal') repGain = getMarketRepForItem('decal', item.starLevel);
    else repGain = getMarketRepForItem(item.rarityKey);
    state.market.reputation += repGain;
  }

  state.listings.splice(lIdx,1);
  state.marketDetailId = null;
  render();
  showToast(`Sold for $${offer.amount.toLocaleString()}! (+${repGain} REP)`);
}

function declineOffer(listingId, offerId){
  const l = state.listings.find(l=>l.id===listingId);
  if(!l) return;
  l.offers = l.offers.filter(o=>o.id!==offerId);
  render();
}

/* --- buyer selection: normal pool + two rare easter-egg buyers --- */
function rollBuyer(){
  const roll = Math.random();
  if(roll < 0.02) return { name:'LowballChud', special:'low' };
  if(roll < 0.025) return { name:'BigMoney$tack$', special:'big' };
  return { name: BUYER_NAMES[Math.floor(Math.random()*BUYER_NAMES.length)], special:null };
}

function computeOfferAmount(value, special){
  if(special==='low') return Math.floor(1 + Math.random()*30); // LowballChud is immune to Hot Product
  const boost = 1 + getHotProductBoost();
  if(special==='big') return Math.round(value * (1.8 + Math.random()*0.4) * boost);
  return Math.max(10, Math.floor(value * rollOfferMultiplier() * boost));
}

/* ---------------------------------------------------------
   GAME LOOP
--------------------------------------------------------- */
function tickWebsites(dt){
  WEBSITES.forEach(site=>{
    if(site.isCarDealer){
      site.refreshTime -= dt;
      if(site.refreshTime <= 0){
        site.listings = generateDealerListings(6);
        site.refreshTime = 600;
      }
      return;
    }

    if(site.upgrades.discount > 0){
      site.discountTimeLeft -= dt;
      if(site.discountTimeLeft <= 0){
        // Shared cycle expired â€” reroll a brand-new batch of discounts.
        site.discounts = generateDiscountBatch(site);
        site.discountTimeLeft = 300;
      }
    }
  });
}

function tickInstalls(dt){
  state.cars.forEach(car=>{
    CATEGORIES.forEach(cat=>{
      car.slots[cat].forEach(slot=>{
        if(slot.installing){
          slot.installing.timeLeft -= dt;
          if(slot.installing.timeLeft <= 0){
            slot.part = slot.installing.part;
            slot.installing = null;
          }
        }
      });
    });
  });
}

let lastTick = performance.now();
let uiRefreshAccum = 0;
function tick(){
  const now = performance.now();
  const dt = (now - lastTick)/1000;
  lastTick = now;

  tickWebsites(dt);
  tickInstalls(dt);
  tickPartfindr(dt);

  let marketChanged = false;
  for(let i=state.listings.length-1;i>=0;i--){
    const l = state.listings[i];
    l.timeLeft -= dt;

    if(Math.random() < dt * 0.18){
      const item = getListingItem(l);
      if(item){
        const value = getItemValue(l, item);
        const buyer = rollBuyer();
        let amount = computeOfferAmount(value, buyer.special);

        const prevOffer = l.offers.filter(o=>o.buyer===buyer.name).sort((a,b)=>b.amount-a.amount)[0];
        if(prevOffer){
          const minRequired = prevOffer.amount + Math.max(1, Math.round(prevOffer.amount*0.05));
          amount = Math.max(amount, minRequired);
        }

        l.offers.push({ id: state.nextId++, buyer: buyer.name, amount });
        marketChanged = true;
      }
    }

    if(l.timeLeft <= 0){
      const item = getListingItem(l);
      if(item) item.listed = false;
      if(state.marketDetailId === l.id) state.marketDetailId = null;
      state.listings.splice(i,1);
      marketChanged = true;
    }
  }
  // Only auto-refresh the Market tab when we're on Your Listings â€” never while the
  // PARTFINDR search input might be focused, or a keystroke-in-progress would be lost.
  if(marketChanged && state.activeTab==='market' && state.market.view==='listings'){
    renderMarket();
  }

  uiRefreshAccum += dt;
  if(uiRefreshAccum >= 1){
    uiRefreshAccum -= 1;
    if(state.activeTab==='websites') renderWebsites();
    if(state.activeTab==='garage' && state.workshopCarId!==null) renderGarage();
    if(state.activeTab==='market' && (state.market.view==='results' || state.market.view==='listings')) renderMarket();
  }

  requestAnimationFrame(tick);
}

/* ---------------------------------------------------------
   INIT
--------------------------------------------------------- */
function initGame(){
  state.cars.push({
    id: state.nextId++,
    name: "'91 Civic Hatch",
    potential: 1,
    bodyStyle: 'hatch',
    color: CAR_COLORS[Math.floor(Math.random()*CAR_COLORS.length)],
    currentProject: true,
    listed: false,
    shellValue: shellValueForPotential(1),
    slots: initCarSlots(1, "'91 Civic Hatch"),
  });
  const dealer = WEBSITES.find(s=>s.isCarDealer);
  dealer.listings = generateDealerListings(6);
}

initGame();
render();
requestAnimationFrame(tick);
</script>
</body>
</html>
