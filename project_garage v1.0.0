    <circle cx="230" cy="112" r="20" fill="#111"/><circle cx="230" cy="112" r="8" fill="#999"/>
    <rect x="257" y="70" width="10" height="7" fill="#ffdd55"/>
    <rect x="18" y="70" width="8" height="7" fill="#cc3333"/>
