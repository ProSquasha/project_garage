    <path d="M20,112 L20,82 Q20,68 40,63 L70,58 Q90,42 130,40 L190,40 Q220,42 235,60 L262,63 Q280,68 280,82 L280,112 Z" fill="${color}" stroke="#000" stroke-width="2"/>
